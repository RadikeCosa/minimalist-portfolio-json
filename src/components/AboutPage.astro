---
import { getAboutContent } from "@/content/about";
import type { Language } from "@/i18n/types";
import Layout from "@/layouts/Layout.astro";
import ActionIcon from "@/components/ActionIcon.astro";

interface Props {
  lang: Language;
  title: string;
  description: string;
  alternateUrl: string;
}

const { lang, title, description, alternateUrl } = Astro.props;
const content = getAboutContent(lang);
const homeHref = lang === "en" ? "/en/" : "/";
const projectsHref = `${homeHref}#projects`;
const contactHref = `${homeHref}#contact`;
const cvHref = lang === "en"
  ? "/cv/CV_Ramiro_Nicolas_Cosa_EN.pdf"
  : "/cv/CV_Ramiro_Nicolas_Cosa.pdf";
const languages = content.languages.split(" · ");
---

<Layout
  title={title}
  description={description}
  lang={lang}
  alternateUrl={alternateUrl}
  isProfile
>
  <main id="main-content" class="reading-page about-page">
    <nav class="back no-print" aria-label={lang === "en" ? "Portfolio navigation" : "Navegación del portfolio"}>
      <a href={homeHref}>{content.back}</a>
    </nav>

    <article class="reading-article">
      <header class="reading-header">
        <h1>{content.title}</h1>
        <div class="copy intro">
          {content.intro.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </header>

      <section id="approach">
        <h2>{content.methodTitle}</h2>
        <div class="copy">
          <p>{content.method}</p>
          <p>{content.methodAi}</p>
        </div>
      </section>

      <section id="experience">
        <h2>{content.backgroundTitle}</h2>
        <div class="copy">
          {content.background.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </section>

      <section id="languages">
        <h2>{content.languagesTitle}</h2>
        <ul class="languages" aria-label={content.languagesTitle}>
          {languages.map((language) => <li>{language}</li>)}
        </ul>
      </section>

      <nav class="actions no-print" aria-label={content.actionsLabel}>
        <a href={projectsHref}><ActionIcon name="projects" />{content.projects}</a>
        <a href={cvHref} download><ActionIcon name="download" />{content.cv}</a>
        <a href={contactHref}><ActionIcon name="email" />{content.contact}</a>
      </nav>
    </article>
  </main>

</Layout>

<style>
  .about-page .reading-header { gap: 28px; }
  .intro { max-width: 65ch; }
  .intro p:first-child { font-size: 20px; line-height: 1.6; }
  .languages { display: flex; flex-wrap: wrap; gap: 12px 24px; margin-top: 20px; }
  .languages li { font-size: 15px; font-weight: 600; }
  .actions { display: flex; flex-wrap: wrap; gap: 8px 24px; border-top: 2px solid var(--ink); padding-top: 24px; }
  .actions a { display: inline-flex; align-items: center; min-height: 44px; gap: 8px; font-size: 14px; font-weight: 700; }
</style>
