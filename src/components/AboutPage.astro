---
import LanguageToggle from "@/components/LanguageToggle.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { getAboutContent } from "@/content/about";
import type { Language } from "@/i18n/types";
import Layout from "@/layouts/Layout.astro";
import ActionIcon from "@/components/ActionIcon.astro";

interface Props {
  lang: Language;
  title: string;
  description: string;
  alternateUrl: string;
}

const { lang, title, description, alternateUrl } = Astro.props;
const content = getAboutContent(lang);
const homeHref = lang === "en" ? "/en/" : "/";
const projectsHref = `${homeHref}#projects`;
const contactHref = `${homeHref}#contact`;
const cvHref = lang === "en"
  ? "/cv/CV_Ramiro_Nicolas_Cosa_EN.pdf"
  : "/cv/CV_Ramiro_Nicolas_Cosa.pdf";
const languages = content.languages.split(" · ");
---

<Layout
  title={title}
  description={description}
  lang={lang}
  alternateUrl={alternateUrl}
  isProfile
>
  <main id="main-content" class="about-page">
    <nav class="back no-print" aria-label={lang === "en" ? "Portfolio navigation" : "Navegación del portfolio"}>
      <a href={homeHref}>{content.back}</a>
    </nav>

    <article>
      <header>
        <h1>{content.title}</h1>
        <div class="copy intro">
          {content.intro.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </header>

      <section>
        <h2>{content.methodTitle}</h2>
        <div class="copy">
          <p>{content.method}</p>
          <p>{content.methodAi}</p>
        </div>
      </section>

      <section>
        <h2>{content.backgroundTitle}</h2>
        <div class="copy">
          {content.background.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </section>

      <section>
        <h2>{content.languagesTitle}</h2>
        <ul class="languages" aria-label={content.languagesTitle}>
          {languages.map((language) => <li>{language}</li>)}
        </ul>
      </section>

      <nav class="actions no-print" aria-label={content.actionsLabel}>
        <a href={projectsHref}><ActionIcon name="projects" />{content.projects}</a>
        <a href={lang === "en" ? "/en/services/" : "/servicios/"}><ActionIcon name="services" />{content.services}</a>
        <a href={cvHref} download><ActionIcon name="download" />{content.cv}</a>
        <a href={contactHref}><ActionIcon name="email" />{content.contact}</a>
      </nav>
    </article>
  </main>

  <LanguageToggle />
  <ThemeToggle />
</Layout>

<style>
  .about-page {
    margin: auto;
    padding: 4rem;
    width: 100%;
  }

  .back,
  article {
    margin-inline: auto;
    max-width: 700px;
  }

  .back {
    margin-bottom: 2.25rem;
  }

  .back a,
  .actions a {
    color: var(--text-primary);
    font-size: 0.78rem;
    font-weight: 650;
  }

  .back a:hover,
  .actions a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .back a:focus-visible,
  .actions a:focus-visible {
    border-radius: 4px;
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  article {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }

  header {
    border-bottom: 1px solid var(--border-light);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-bottom: 1.75rem;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  section {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  section + section {
    border-top: 1px solid var(--border-light);
    padding-top: 1.5rem;
  }

  h2 {
    align-items: center;
    display: flex;
    font-size: 1.2rem;
    gap: 8px;
    line-height: 1.35;
  }

  h2::before {
    background: var(--accent);
    border-radius: 999px;
    content: "";
    flex: 0 0 auto;
    height: 5px;
    width: 5px;
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .copy p,
  .languages {
    font-size: 0.92rem;
    line-height: 1.65;
  }

  .intro p:first-child {
    color: var(--text-primary);
    font-size: 1rem;
  }

  .languages {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
  }

  .languages li {
    background: var(--bg-secondary);
    border-radius: 6px;
    color: var(--text-secondary);
    font-size: 0.76rem;
    font-weight: 550;
    line-height: 1.3;
    padding: 0.3rem 0.62rem;
  }

  .actions {
    align-items: center;
    border-top: 1px solid var(--border-light);
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
    padding-top: 1.5rem;
  }

  .actions a {
    align-items: center;
    display: inline-flex;
    flex: 0 0 auto;
    flex-direction: row;
    gap: 6px;
    white-space: nowrap;
  }

  @media (width <= 700px) {
    .about-page {
      padding: 2rem 1.25rem;
    }

    .back {
      margin-bottom: 1.75rem;
      padding-right: 7rem;
    }

    article {
      gap: 2rem;
    }

    .copy p {
      font-size: 0.9rem;
    }
  }
</style>
