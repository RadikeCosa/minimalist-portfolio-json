---
import { getAboutContent } from "@/content/about";
import type { Language } from "@/i18n/types";
import Layout from "@/layouts/Layout.astro";
import ActionIcon from "@/components/ActionIcon.astro";

interface Props {
  lang: Language;
  title: string;
  description: string;
  alternateUrl: string;
}

const { lang, title, description, alternateUrl } = Astro.props;
const content = getAboutContent(lang);
const homeHref = lang === "en" ? "/en/" : "/";
const projectsHref = `${homeHref}#projects`;
const contactHref = `${homeHref}#contact`;
const cvHref = lang === "en"
  ? "/cv/CV_Ramiro_Nicolas_Cosa_EN.pdf"
  : "/cv/CV_Ramiro_Nicolas_Cosa.pdf";
const languages = content.languages.split(" · ");
---

<Layout
  title={title}
  description={description}
  lang={lang}
  alternateUrl={alternateUrl}
  isProfile
>
  <main tabindex="-1" id="main-content" class="reading-page about-page">
    <nav class="back no-print" aria-label={lang === "en" ? "Portfolio navigation" : "Navegación del portfolio"}>
      <a href={homeHref}>{content.back}</a>
    </nav>

    <article class="reading-article about-article">
      <header class="about-header">
        <div class="about-heading">
          <h1>{content.title}<span aria-hidden="true">.</span></h1>
          <p class="profile-label">{content.profile}</p>
        </div>
        <div class="copy intro">
          {content.intro.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </header>

      <section class="about-section method-section" id="approach">
        <h2>{content.methodTitle}</h2>
        <div class="copy">
          <p>{content.method}</p>
          <aside class="ai-note" aria-labelledby="ai-title">
            <h3 id="ai-title">{content.aiTitle}</h3>
            <p>{content.methodAi}</p>
          </aside>
        </div>
      </section>

      <section class="about-section experience-section" id="experience">
        <h2>{content.backgroundTitle}</h2>
        <ul class="background-list">
          {content.background.map((paragraph, index) => (
            <li>
              <p class="period">{content.periods[index]}</p>
              <p>{paragraph}</p>
            </li>
          ))}
        </ul>
      </section>

      <section class="about-section languages-section" id="languages">
        <h2>{content.languagesTitle}</h2>
        <ul class="languages" aria-label={content.languagesTitle}>
          {languages.map((language) => {
            const [name, level] = language.split(" — ");
            return <li><span class="language-name" translate="no">{name}</span><span class="language-level" translate="no">{level}</span></li>;
          })}
        </ul>
      </section>

      <nav class="actions no-print" aria-label={content.actionsLabel}>
        <a class="button button-primary" href={cvHref} download><ActionIcon name="download" />{content.cv}</a>
        <a class="text-link" href={projectsHref}><ActionIcon name="projects" />{content.projects}</a>
        <a class="text-link" href={contactHref}><ActionIcon name="email" />{content.contact}</a>
      </nav>
    </article>
  </main>

</Layout>

<style>
  .about-page { --reading-width: 1104px; }
  .about-article { gap: 64px; }
  .about-header { display: grid; grid-template-columns: minmax(0,4fr) minmax(0,7fr); gap: 56px; align-items: start; padding-bottom: 56px; border-bottom: 4px solid var(--ink); }
  .about-heading { display: flex; flex-direction: column; align-items: flex-start; gap: 32px; }
  h1 { font-size: clamp(56px,7vw,96px); font-weight: 900; line-height: .95; letter-spacing: -.045em; text-transform: uppercase; }
  h1 span { color: var(--red); }
  .profile-label { border-left: 4px solid var(--ink); padding: 12px 16px; background: var(--yellow); font-size: 13px; line-height: 1.5; font-weight: 700; }
  .intro { max-width: 65ch; }
  .intro p:first-child { font-size: clamp(20px,1.65vw,24px); line-height: 1.55; font-weight: 600; }
  .about-article > .about-section { display: grid; grid-template-columns: minmax(0,3fr) minmax(0,8fr); gap: 48px; }
  .about-section h2 { font-size: clamp(28px,2.6vw,36px); }
  .method-section h2 { color: var(--blue); }
  .experience-section h2 { color: var(--red); }
  .ai-note { border-left: 4px solid var(--blue); padding: 4px 0 4px 24px; margin-top: 12px; }
  .ai-note h3 { font-size: 17px; margin-bottom: 12px; }
  .background-list { display: flex; flex-direction: column; gap: 28px; max-width: 65ch; }
  .background-list li { display: grid; grid-template-columns: 116px minmax(0,1fr); gap: 24px; }
  .background-list li + li { border-top: 2px solid var(--ink); padding-top: 28px; }
  .period { font-size: 14px; font-weight: 800; color: var(--blue); }
  .languages { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 24px; }
  .languages li { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; min-width: 0; overflow-wrap: anywhere; }
  .language-name { font-size: 18px; font-weight: 800; }
  .language-level { font-size: 14px; line-height: 1.6; border-bottom: 4px solid var(--yellow); }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 20px 32px; border-top: 4px solid var(--ink); padding-top: 32px; }
  .actions .text-link { gap: 8px; font-size: 14px; }
  @media (width < 1024px) {
    .about-header { grid-template-columns: 1fr; gap: 32px; padding-bottom: 32px; }
    .about-heading { gap: 24px; }
    .about-article > .about-section { grid-template-columns: 1fr; gap: 28px; }
  }
  @media (width < 768px) {
    .about-article { gap: 40px; }
    .background-list li { grid-template-columns: 1fr; gap: 12px; }
    .languages { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 24px 20px; }
    .ai-note { padding-left: 16px; }
  }
  @media print {
    .about-page { --reading-width: 760px; }
    .about-header,.about-article > .about-section { grid-template-columns: 1fr; gap: 24px; }
    .about-article { gap: 32px; }
    h1 { font-size: 48px; }
    .profile-label { background: var(--paper); }
    h2,.period { color: var(--ink) !important; }
    .ai-note { border-color: var(--ink); }
    .language-level { border-color: var(--ink); }
  }
</style>
