---
import Section from "../Section.astro";
import { getLangFromUrl } from "@/i18n/utils";
import type { Language } from "@/i18n/types";
import { getHomeContent } from "@/content/home";

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const { capabilities } = getHomeContent(currentLang);
---

<Section id="capabilities" title={capabilities.title}>
  <div class="groups">
    {capabilities.groups.map((group) => (
      <section class="group">
        <h3>{group.title}</h3>
        <ul>{group.items.map((item) => <li>{item}</li>)}</ul>
      </section>
    ))}
  </div>
</Section>

<style>
  .groups { display: grid; gap: 24px 28px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .group { border-top: 1px solid var(--border); padding-top: 12px; }
  h3 { font-size: 0.92rem; margin-bottom: 10px; }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  li {
    background: var(--bg-secondary);
    border-radius: 6px;
    color: var(--text-secondary);
    font-size: 0.72rem;
    font-weight: 550;
    padding: 0.28rem 0.58rem;
  }
  @media (width <= 560px) { .groups { grid-template-columns: 1fr; } }
</style>
