---
import Section from "@/components/Section.astro";
import type { Language } from "@/i18n/types";
interface Props { lang: Language }
const { lang } = Astro.props;
const technologies = ["TypeScript", "React", "Next.js", "PostgreSQL", "Supabase", "Vitest", "Playwright"];
---
<Section id="skills" title={lang === "en" ? "Technologies" : "Tecnologías"}>
  <ul class="technology-list">{technologies.map(technology => <li>{technology}</li>)}</ul>
</Section>
<style>
  .technology-list { display: flex; flex-wrap: wrap; gap: 16px 28px; padding-block: 24px; border-block: 2px solid var(--ink); }
  li { font-size: 15px; font-weight: 700; letter-spacing: .04em; }
</style>
