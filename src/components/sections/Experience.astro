---
import Section from "../Section.astro";
import { getLangFromUrl, useTranslations, getCV, getYear } from "@/i18n/utils";
import type { Language } from "@/i18n/types";

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const cvData = await getCV(currentLang);

// Usar los datos del CV según el idioma actual
const { work } = cvData;

const formatPeriod = (period: { startDate: string; endDate: string | null }) => {
  const startYear = getYear(period.startDate) ?? "";
  const endYear = period.endDate
    ? getYear(period.endDate) ?? ""
    : t("date.present");

  return { startYear, endYear };
};
---

<Section title={t("section.experience")}>
  <p class="experience-intro">{t("section.experienceIntro")}</p>

  <ul class="experience-list">
    {
      work.map(({ stageTitle, context, periods, summary, highlights }, index) => (
        <li>
          <article>
            <header>
              <p class="stage-meta">
                {context && <span>{context}</span>}
                {context && <span aria-hidden="true"> · </span>}
                {periods.map((period, index) => {
                  const { startYear, endYear } = formatPeriod(period);

                  return (
                    <>
                      {index > 0 && <span class="period-separator"> / </span>}
                      <span class="period">
                        <time datetime={period.startDate}>{startYear}</time>
                        {" — "}
                        {period.endDate ? (
                          <time datetime={period.endDate}>{endYear}</time>
                        ) : (
                          <span>{endYear}</span>
                        )}
                      </span>
                    </>
                  );
                })}
              </p>

              <h3>{stageTitle}</h3>
            </header>

            <p class="stage-summary">{summary}</p>

            {
              highlights?.length > 0 && (
                <ul class="highlights-list">
                  {highlights.map((highlight) => (
                    <li>{highlight}</li>
                  ))}
                </ul>
              )
            }

            {
              index === 0 && (
                <p class="services-link no-print">
                  <a href={currentLang === "en" ? "/en/services/" : "/servicios/"}>
                    {currentLang === "en"
                      ? "Services and independent work →"
                      : "Servicios y trabajo independiente →"}
                  </a>
                </p>
              )
            }
          </article>
        </li>
      ))
    }
  </ul>

  <p class="about-link">
    <a href={currentLang === "en" ? "/en/about/" : "/sobre-mi/"}>
      {currentLang === "en" ? "More about my background" : "Más sobre mi recorrido"}
    </a>
  </p>
</Section>

<style>
  .experience-intro {
    margin-bottom: 28px;
  }

  .experience-list {
    display: flex;
    flex-direction: column;
    gap: 42px;
  }

  article {
    display: flex;
    flex-direction: column;
    gap: 10px;
    break-inside: avoid;
  }

  header {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .stage-meta {
    color: var(--text-muted);
    font-size: 0.78rem;
    line-height: 1.45;
    text-wrap: pretty;
  }

  .period {
    display: inline-block;
  }

  .period-separator {
    color: var(--text-muted);
  }

  article h3 {
    color: var(--text-primary);
    font-size: 1.05rem;
    font-weight: 650;
    line-height: 1.35;
  }

  .stage-summary {
    color: var(--text-secondary);
  }

  .highlights-list {
    color: var(--text-secondary);
    display: flex;
    flex-direction: column;
    font-size: 0.86rem;
    gap: 6px;
    line-height: 1.45;
    margin-top: 2px;
    padding-left: 16px;
    list-style: disc;
  }

  time {
    cursor: default;
  }

  .about-link {
    margin-top: 24px;
  }

  .services-link {
    margin-top: 4px;
  }

  .services-link a,
  .about-link a {
    color: var(--text-primary);
    font-size: 0.78rem;
    font-weight: 650;
  }

  .services-link a:hover,
  .about-link a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .services-link a:focus-visible,
  .about-link a:focus-visible {
    border-radius: 4px;
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  @media (width <= 700px) {
    .experience-intro {
      margin-bottom: 24px;
    }

    .experience-list {
      gap: 36px;
    }

    article h3 {
      font-size: 1rem;
    }

    .stage-meta {
      font-size: 0.76rem;
    }

    .highlights-list {
      padding-left: 14px;
    }
  }
</style>
