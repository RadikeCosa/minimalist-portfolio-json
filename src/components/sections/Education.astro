---
import Section from "../Section.astro";
import { getLangFromUrl, useTranslations, getCV, getYear } from "@/i18n/utils";
import type { Language } from "@/i18n/types";

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const cvData = await getCV(currentLang);

// Usar los datos del CV según el idioma actual
const { educationGroups } = cvData;

const formatDateRange = (startDate: string, endDate: string | null) => {
  const startYear = getYear(startDate) ?? "";
  const endYear = endDate ? getYear(endDate) ?? "" : t("date.present");

  return {
    startYear,
    endYear,
    isSingleYear: endDate !== null && startYear === endYear,
  };
};
---

<Section title={t("section.education")}>
  <div class="education-groups">
    {
      educationGroups.map(({ title, items, closingNote }, groupIndex) => (
        <section class="education-group" aria-labelledby={`education-group-${groupIndex}`}>
          <h3 id={`education-group-${groupIndex}`}>{title}</h3>

          <ul class="education-list">
            {items.map(
              ({ title, institution, startDate, endDate, description, details }) => {
                const { startYear, endYear, isSingleYear } = formatDateRange(
                  startDate,
                  endDate
                );

                return (
                  <li>
                    <article>
                      <header>
                        <h4>{title}</h4>
                        <p class="education-meta">
                          <span>{institution}</span>
                          <span aria-hidden="true"> · </span>
                          <span class="period">
                            <time datetime={startDate}>{startYear}</time>
                            {!isSingleYear && (
                              <>
                                {" — "}
                                {endDate ? (
                                  <time datetime={endDate}>{endYear}</time>
                                ) : (
                                  <span>{endYear}</span>
                                )}
                              </>
                            )}
                          </span>
                        </p>
                      </header>

                      {description && <p class="education-description">{description}</p>}

                      {details.length > 0 && (
                        <ul class="details-list">
                          {details.map((detail) => (
                            <li>{detail}</li>
                          ))}
                        </ul>
                      )}
                    </article>
                  </li>
                );
              }
            )}
          </ul>

          {closingNote && <p class="closing-note">{closingNote}</p>}
        </section>
      ))
    }
  </div>
</Section>

<style>
  .education-groups {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .education-group {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .education-group h3 {
    color: var(--text-primary);
    font-size: 1.05rem;
    font-weight: 650;
    line-height: 1.35;
  }

  .education-list {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  article {
    break-inside: avoid;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  header {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  article h4 {
    color: var(--text-primary);
    font-size: 0.96rem;
    font-weight: 560;
    line-height: 1.35;
  }

  .education-list > li:first-child article h4 {
    font-weight: 650;
  }

  .education-meta {
    color: var(--text-muted);
    font-size: 0.78rem;
    line-height: 1.45;
    text-wrap: pretty;
  }

  .period {
    display: inline-block;
  }

  .education-description,
  .closing-note {
    color: var(--text-secondary);
  }

  .details-list {
    color: var(--text-secondary);
    display: flex;
    flex-direction: column;
    font-size: 0.86rem;
    gap: 4px;
    line-height: 1.45;
    padding-left: 16px;
    list-style: disc;
  }

  .closing-note {
    margin-top: 2px;
  }

  @media (width <= 700px) {
    .education-groups {
      gap: 36px;
    }

    .education-group {
      gap: 16px;
    }

    .education-list {
      gap: 20px;
    }

    .education-group h3 {
      font-size: 1rem;
    }

    .education-meta {
      font-size: 0.76rem;
    }

    .details-list {
      padding-left: 14px;
    }
  }
</style>
