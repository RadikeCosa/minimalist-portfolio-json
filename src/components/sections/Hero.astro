---
import { getLangFromUrl, getCV } from "@/i18n/utils";
import type { Language } from "@/i18n/types";
import Section from "@/components/Section.astro";
import WorldMap from "@/icons/WorldMap.astro";
import { getHomeContent } from "@/content/home";

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const { basics } = await getCV(currentLang);
const { hero } = getHomeContent(currentLang);
---

<Section id="top">
  <header class="hero">
    <p class="name">{basics.name}</p>
    <h1>{hero.title}</h1>
    <p class="description">{hero.description}</p>

    <div class="context">
      <p>{hero.context}</p>
      <p class="location">
        <WorldMap />
        <span>{basics.location.city}, {basics.location.region}</span>
      </p>
    </div>

    <nav class="actions" aria-label={currentLang === "en" ? "Main actions" : "Acciones principales"}>
      <a class="primary" href="#projects">{hero.primaryAction}</a>
      <a href="#contact">{hero.secondaryAction}</a>
    </nav>

    <p class="print">{basics.email} · {basics.phone} · {basics.url}</p>
  </header>
</Section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-block: 22px 10px;
  }

  .name {
    color: var(--text-primary);
    font-size: 0.88rem;
    font-weight: 700;
  }

  h1 {
    font-size: clamp(2rem, 6vw, 3.25rem);
    letter-spacing: -0.045em;
    line-height: 1.05;
    max-width: 20ch;
    text-wrap: balance;
  }

  .description {
    font-size: 1rem;
    line-height: 1.65;
    max-width: 62ch;
  }

  .context {
    display: flex;
    flex-direction: column;
    gap: 5px;
    margin-top: 4px;
  }

  .context p {
    color: var(--text-muted);
    font-size: 0.76rem;
  }

  .location {
    align-items: flex-start;
    display: flex;
    gap: 6px;
  }

  .location :global(svg) {
    flex: 0 0 auto;
    margin-top: 2px;
  }

  .actions {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
    margin-top: 10px;
  }

  .actions a {
    color: var(--text-primary);
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none;
  }

  .actions a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .actions a:focus-visible {
    border-radius: 4px;
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .actions .primary {
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 9px 12px;
  }

  .actions .primary:hover {
    background: var(--bg-secondary);
    text-decoration: none;
  }

  @media (width <= 700px) {
    .hero { padding-top: 6px; }
    h1 { font-size: clamp(1.9rem, 10vw, 2.65rem); }
  }
</style>
