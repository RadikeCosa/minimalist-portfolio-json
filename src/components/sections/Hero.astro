---
import { getLangFromUrl, useTranslations, getCV } from "@/i18n/utils";
import type { Language } from "@/i18n/types";
import Section from "@/components/Section.astro";
import Mail from "@/icons/Mail.astro";
import Phone from "@/icons/Phone.astro";
import X from "@/icons/X.astro";
import LinkedIn from "@/icons/LinkedIn.astro";
import GitHub from "@/icons/GitHub.astro";
import WorldMap from "@/icons/WorldMap.astro";
import type { SocialIcon } from "@/types";

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const cvData = await getCV(currentLang);

// Usar los datos del CV según el idioma actual
const { name, label, location, profiles, phone, email } = cvData.basics;
const { city, region } = location;

const SOCIAL_ICONS: SocialIcon = {
  GitHub,
  LinkedIn,
  X,
};

const linkedInfo = profiles.find(({ network }) => network === "LinkedIn");
const linkedUrl = linkedInfo?.url;
const phoneHref = phone.replace(/[^\d+]/g, "");
const healthtechProjectLabel =
  currentLang === "en" ? "View HealthTech project →" : "Ver proyecto HealthTech →";

const printInfo = [email, phone, linkedUrl].filter(Boolean).join(" • ");
---

<Section>
  <div class="container">
    <div class="info">
      <h1>{name}</h1>
      <h2>{label}</h2>
      <span>
        <WorldMap />
        {city}, {region}
      </span>
      <footer class="print">
        {printInfo}
      </footer>
      <footer class="social-actions no-print">
        {
          email && (
            <a
              href={`mailto:${email}`}
              title={`${t("contact.send")} ${name}: ${email}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Mail />
            </a>
          )
        }
        {
          phone && (
            <a
              href={`tel:${phoneHref}`}
              title={`${t("contact.call")} ${name} ${phone}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Phone />
            </a>
          )
        }
        {
          profiles.map(({ network, url }) => {
            const Icon = SOCIAL_ICONS[network];

            return (
              <a
                href={url}
                title={`${t("contact.visit")} ${name}: ${network}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                <Icon />
              </a>
            );
          })
        }
        <a class="healthtech-link" href="#healthtech-project">
          {healthtechProjectLabel}
        </a>
      </footer>
    </div>
    <figure></figure>
  </div>
</Section>

<style>
  .container {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-right: 32px;
  }

  h1 {
    font-size: 2rem;
  }

  h2 {
    color: var(--text-secondary);
    font-weight: 500;
    font-size: 1.1rem;
    text-wrap: balance;
  }

  img {
    aspect-ratio: 1 / 1;
    object-fit: cover;
    width: 128px;
    border-radius: 16px;
  }

  span {
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.85rem;
    letter-spacing: -0.05rem;
  }

  footer {
    color: var(--text-muted);
    font-size: 0.65rem;
    display: flex;
    gap: 4px;
    margin-top: 8px;
  }

  footer a {
    background: var(--bg-primary);
    color: var(--text-muted);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #eee;
    padding: 4px;
    height: 32px;
    width: 32px;
    border-radius: 6px;
    transition: all 0.3s ease;
  }

  .social-actions {
    align-items: center;
    flex-wrap: wrap;
  }

  .social-actions .healthtech-link {
    background: transparent;
    border-color: transparent;
    color: var(--text-secondary);
    font-size: 0.75rem;
    font-weight: 600;
    height: 32px;
    margin-left: 4px;
    padding-inline: 6px;
    width: auto;
  }

  footer a:hover {
    background: var(--bg-hover);
    border: 1px solid var(--border);
  }

  .social-actions .healthtech-link:hover {
    background: transparent;
    border-color: transparent;
    color: var(--text-primary);
    text-decoration: underline;
  }

  footer a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  @media (width <= 700px) {
    .container {
      flex-direction: column-reverse;
    }

    .info {
      justify-content: center;
      align-items: center;
      padding-right: 0;
      text-align: center;
    }

    .social-actions {
      justify-content: center;
    }

    .social-actions .healthtech-link {
      margin-left: 0;
    }

    figure {
      display: flex;
      justify-content: center;
      align-items: center;
    }

    h2 {
      text-wrap: balance;
    }

    figure {
      margin: 0 auto;
    }
  }
</style>
