---
import type { Language } from "@/i18n/types";
import { getHomeContent } from "@/content/home";
interface Props { lang: Language }
const { lang } = Astro.props;
const en = lang === "en";
const { hero } = getHomeContent(lang);
const cvHref = en ? "/cv/CV_Ramiro_Nicolas_Cosa_EN.pdf" : "/cv/CV_Ramiro_Nicolas_Cosa.pdf";
---
<section class="hero section" id="top" aria-labelledby="hero-title">
  <p class="eyebrow">{en ? "Web developer · Functional analysis" : "Desarrollo web · Análisis funcional"}</p>
  <div class="hero-copy">
    <h1 id="hero-title" class:list={[{ english: en }]}>{en ? <>Web <span class="hero-long-word">development.</span></> : "Desarrollo web."}<br />{en ? "From problem to " : "Del problema al "}<span class="hero-accent">{en ? "product." : "producto."}</span></h1>
    <p class="hero-description">{hero.description}</p>
    <nav class="action-row" aria-label={en ? "Explore my work" : "Explorar mi trabajo"}>
      <a class="button button-primary" href="#projects">{hero.primaryAction}</a>
      <a class="button" href={cvHref} download>{hero.cvAction}</a>
    </nav>
  </div>
  <img class="emblem" src="/brand-mark.svg" width="208" height="112" alt="" aria-hidden="true" />
</section>
<style>
  .hero { display: grid; grid-template-columns: minmax(0,7fr) minmax(0,5fr); gap: 28px 32px; align-items: center; padding-block: 24px 8px; }
  .eyebrow { grid-column: 1; align-self: end; }
  .hero-copy { grid-column: 1; grid-row: 2; display: flex; flex-direction: column; align-items: flex-start; gap: 28px; min-width: 0; }
  h1 { font-size: clamp(36px,5.2vw,76px); line-height: 1.02; font-weight: 900; text-transform: uppercase; letter-spacing: -.035em; }
  h1.english { font-size: clamp(36px,4.7vw,68px); }
  h1 .hero-accent { color: var(--blue); }
  .hero-description { max-width: 52ch; font-size: 18px; }
  .emblem { grid-column: 2; grid-row: 1 / span 2; aspect-ratio: 208 / 112; width: 100%; height: auto; max-width: 280px; justify-self: end; }
  @media (width < 1024px) {
    .hero { grid-template-columns: minmax(0,1fr) 112px; }
    .eyebrow { align-self: center; max-width: 28ch; }
    .hero-copy { grid-column: 1 / -1; }
    .emblem { grid-row: 1; width: 112px; height: auto; }
    h1,h1.english { font-size: clamp(36px,7.5vw,72px); }
  }
  @media (width < 768px) {
    .hero { grid-template-columns: minmax(0,1fr) 72px; gap: 24px; padding-block: 0; }
    .hero-copy { gap: 24px; }
    .emblem { width: 72px; height: auto; }
    h1,h1.english { font-size: clamp(36px,8.5vw,56px); }
    h1.english .hero-long-word { letter-spacing: -.07em; }
    .hero-description { font-size: 17px; }
    .eyebrow { font-size: 11px; }
  }
</style>
