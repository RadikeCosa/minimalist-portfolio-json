---
import { getLangFromUrl, getCV } from "@/i18n/utils";
import type { Language } from "@/i18n/types";
import Section from "@/components/Section.astro";
import WorldMap from "@/icons/WorldMap.astro";
import ActionIcon from "@/components/ActionIcon.astro";
import { getHomeContent } from "@/content/home";

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const { basics } = await getCV(currentLang);
const { hero } = getHomeContent(currentLang);
const cvHref = currentLang === "en"
  ? "/cv/CV_Ramiro_Nicolas_Cosa_EN.pdf"
  : "/cv/CV_Ramiro_Nicolas_Cosa.pdf";
const aboutHref = currentLang === "en" ? "/en/about/" : "/sobre-mi/";
const servicesHref = currentLang === "en" ? "/en/services/" : "/servicios/";
---

<Section id="top">
  <header class="hero">
    <p class="name">{basics.name}</p>
    <h1>{hero.title}</h1>
    <p class="description">{hero.description}</p>

    <div class="context">
      <p>{hero.context}</p>
      <p class="location">
        <WorldMap />
        <span>{basics.location.city}, {basics.location.region}</span>
      </p>
    </div>

    <nav class="hero-nav" aria-label={currentLang === "en" ? "Portfolio navigation" : "Navegación del portfolio"}>
      <div class="destinations">
        <a href="#projects"><ActionIcon name="projects" />{hero.primaryAction}</a>
        <a href={aboutHref}><ActionIcon name="about" />{hero.aboutAction}</a>
        <a href={servicesHref}><ActionIcon name="services" />{hero.servicesAction}</a>
      </div>
      <div class="utilities">
        <a href={cvHref} download><ActionIcon name="download" />{hero.cvAction}</a>
        <a href="#contact"><ActionIcon name="email" />{hero.secondaryAction}</a>
      </div>
    </nav>

    <p class="print">{basics.email} · {basics.phone} · {basics.url}</p>
  </header>
</Section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-block: 22px 10px;
  }

  .name {
    color: var(--text-primary);
    font-size: 0.88rem;
    font-weight: 700;
  }

  h1 {
    font-size: clamp(2rem, 6vw, 3.25rem);
    letter-spacing: -0.045em;
    line-height: 1.05;
    max-width: 20ch;
    text-wrap: balance;
  }

  .description {
    font-size: 1rem;
    line-height: 1.65;
    max-width: 62ch;
  }

  .context {
    display: flex;
    flex-direction: column;
    gap: 5px;
    margin-top: 4px;
  }

  .context p {
    color: var(--text-muted);
    font-size: 0.76rem;
  }

  .location {
    align-items: flex-start;
    display: flex;
    gap: 6px;
  }

  .location :global(svg) {
    flex: 0 0 auto;
    margin-top: 2px;
  }

  .hero-nav,
  .destinations,
  .utilities {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
  }

  .hero-nav {
    gap: 12px 22px;
    margin-top: 10px;
  }

  .destinations,
  .utilities {
    gap: 10px 18px;
  }

  .utilities {
    border-left: 1px solid var(--border);
    padding-left: 22px;
  }

  .hero-nav a {
    align-items: center;
    color: var(--text-primary);
    display: inline-flex;
    flex: 0 0 auto;
    flex-direction: row;
    font-size: 0.78rem;
    font-weight: 700;
    gap: 6px;
    text-decoration: none;
    white-space: nowrap;
  }

  .hero-nav a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .hero-nav a:focus-visible {
    border-radius: 4px;
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  @media (width <= 700px) {
    .hero { padding-top: 6px; }
    h1 { font-size: clamp(1.9rem, 10vw, 2.65rem); }
    .hero-nav {
      align-items: flex-start;
      flex-direction: column;
    }
    .utilities {
      border-left: 0;
      padding-left: 0;
    }
  }
</style>
