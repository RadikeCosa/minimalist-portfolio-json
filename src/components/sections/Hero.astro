---
import { getLangFromUrl, getCV } from "@/i18n/utils";
import type { Language } from "@/i18n/types";
import Section from "@/components/Section.astro";
import WorldMap from "@/icons/WorldMap.astro";
import ActionIcon from "@/components/ActionIcon.astro";
import { getHomeContent } from "@/content/home";

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const { basics } = await getCV(currentLang);
const { hero } = getHomeContent(currentLang);
const cvHref = currentLang === "en"
  ? "/cv/CV_Ramiro_Nicolas_Cosa_EN.pdf"
  : "/cv/CV_Ramiro_Nicolas_Cosa.pdf";
const aboutHref = currentLang === "en" ? "/en/about/" : "/sobre-mi/";
const clinicalCaseHref = currentLang === "en" ? "/en/projects/clinical-platform/" : "/proyectos/plataforma-clinica/";
---

<Section id="top">
  <header class="hero">
    <p class="name">{basics.name}</p>
    <h1>{hero.title}</h1>
    <p class="description">{hero.description}</p>

    <div class="context">
      <p>{hero.context}</p>
      <p class="location">
        <WorldMap />
        <span>{basics.location.city}, {basics.location.region}</span>
      </p>
    </div>

    <nav class="hero-nav" aria-label={currentLang === "en" ? "Portfolio navigation" : "Navegación del portfolio"}>
      <a class="primary-action" href={clinicalCaseHref}><ActionIcon name="projects" />{hero.primaryAction}</a>
      <div class="supporting-actions">
        <a href={cvHref} download><ActionIcon name="download" />{hero.cvAction}</a>
        <a href="#contact"><ActionIcon name="email" />{hero.secondaryAction}</a>
        <a href={aboutHref}><ActionIcon name="about" />{hero.aboutAction}</a>
      </div>
    </nav>

    <p class="print">{basics.email} · {basics.phone} · {basics.url}</p>
  </header>
</Section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: clamp(56px, 7vw, 88px);
    max-width: 960px;
    padding-block: 28px 10px;
  }

  .name {
    color: var(--text-primary);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.86rem;
    letter-spacing: 0;
    font-weight: 600;
  }

  h1 {
    font-size: clamp(2.8rem, 6vw, 4.5rem);
    letter-spacing: -0.055em;
    line-height: 0.99;
    max-width: 22ch;
    text-wrap: balance;
  }

  .description {
    color: var(--text-primary);
    font-size: clamp(1.1rem, 1.5vw, 1.35rem);
    line-height: 1.5;
    max-width: 54ch;
  }

  .context {
    display: flex;
    flex-direction: column;
    gap: 7px;
    margin-top: 5px;
  }

  .context p {
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  .location {
    align-items: flex-start;
    display: flex;
    gap: 6px;
  }

  .location :global(svg) {
    flex: 0 0 auto;
    margin-top: 2px;
  }

  .hero-nav,
  .supporting-actions {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
  }

  .hero-nav {
    align-items: flex-start;
    flex-direction: column;
    gap: 18px;
    margin-top: 12px;
  }

  .supporting-actions {
    gap: 10px 22px;
  }

  .hero-nav a {
    align-items: center;
    color: var(--text-primary);
    display: inline-flex;
    flex: 0 0 auto;
    flex-direction: row;
    font-size: 0.94rem;
    font-weight: 650;
    gap: 8px;
    min-height: 44px;
    text-decoration: none;
    white-space: nowrap;
  }

  .hero-nav .primary-action {
    background: var(--accent);
    border-radius: 7px;
    color: var(--accent-contrast);
    padding: 10px 16px;
  }

  .hero-nav a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .hero-nav a:focus-visible {
    border-radius: 4px;
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  @media (width <= 700px) {
    .hero { padding-top: 6px; }
    h1 { font-size: clamp(2.65rem, 13vw, 4rem); }
    .hero-nav {
      align-items: flex-start;
      flex-direction: column;
    }
    .supporting-actions { gap: 4px 16px; }
    .hero { margin-bottom: 56px; }
  }
</style>
