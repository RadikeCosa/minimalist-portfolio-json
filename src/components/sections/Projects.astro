---
import Section from "../Section.astro";
import { getLangFromUrl, useTranslations, getCV } from "@/i18n/utils";
import type { Language } from "@/i18n/types";

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const cvData = await getCV(currentLang);

// Usar los datos del CV según el idioma actual
const { projects } = cvData;
---

<Section id="projects" title={t("section.projects")}>
  <ul class="project-list">
    {
      projects.map(
        ({ url, description, highlights, name, featured, badge, github, caseStudyUrl }) => {
          return (
            <li class:list={["project-item", { featured }]}>
              <article>
                <header>
                  {badge && <p class="project-badge">{badge}</p>}
                  <h3>{name}</h3>
                  <p>{description}</p>
                </header>
                <footer>
                  <ul class="project-stack" aria-label={t("project.stackLabel")}>
                    {highlights.map((highlight) => {
                      return <li>{highlight}</li>;
                    })}
                  </ul>
                  <nav class="project-actions" aria-label={name}>
                    {caseStudyUrl && (
                      <a
                        class="project-case-link"
                        href={caseStudyUrl}
                        title={`${t("project.caseStudyTitle")} ${name}`}
                      >
                        {t("project.caseStudy")}
                      </a>
                    )}
                    <div class="project-links">
                      <a
                        href={url}
                        target="_blank"
                        rel="noopener noreferrer"
                        title={`${t("project.visit")} ${name}`}
                      >
                        <svg
                          aria-hidden="true"
                          class="project-link-icon"
                          width="13"
                          height="13"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <path d="M15 3h6v6"></path>
                          <path d="M10 14 21 3"></path>
                          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                        </svg>
                        {t("project.visitLabel")}
                      </a>
                      {github && (
                        <a
                          href={github}
                          target="_blank"
                          rel="noopener noreferrer"
                          title={`${t("project.source")} ${name}`}
                        >
                          <svg
                            aria-hidden="true"
                            class="project-link-icon"
                            width="13"
                            height="13"
                            viewBox="0 0 24 24"
                            xmlns="http://www.w3.org/2000/svg"
                          >
                            <path
                              fill="currentColor"
                              d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
                            ></path>
                          </svg>
                          {t("project.sourceLabel")}
                        </a>
                      )}
                    </div>
                  </nav>
                </footer>
              </article>
            </li>
          );
        }
      )
    }
  </ul>
</Section>

<style>
  .project-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .project-item:not(.featured) {
    grid-column: 1 / -1;
  }

  article {
    border-radius: 8px;
    border: 1px solid var(--border-light);
    background: var(--bg-primary);
    gap: 18px;
    display: flex;
    flex-direction: column;
    padding: 18px;
    height: 100%;
  }

  article header {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 7px;
  }

  .project-badge {
    align-items: center;
    color: var(--text-muted);
    display: inline-flex;
    font-size: 0.64rem;
    font-weight: 600;
    gap: 6px;
    line-height: 1.2;
    margin-bottom: 0;
    padding: 0;
  }

  .project-badge::before {
    background: currentColor;
    border-radius: 999px;
    content: "";
    height: 5px;
    opacity: 0.75;
    width: 5px;
  }

  article h3 {
    font-size: 1rem;
    line-height: 1.35;
  }

  article a {
    color: var(--text-primary);
  }

  article a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  article a:focus-visible {
    border-radius: 4px;
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  article p {
    font-size: 0.75rem;
    line-height: 1.35;
  }

  footer {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .project-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }

  .project-stack li {
    border-radius: 6px;
    background: var(--bg-secondary);
    color: var(--text-secondary);
    font-size: 0.6rem;
    font-weight: 500;
    line-height: 1.2;
    padding: 0.22rem 0.62rem;
  }

  .project-actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .project-case-link {
    align-self: flex-start;
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    font-size: 0.72rem;
    font-weight: 600;
  }

  .project-links a {
    align-items: center;
    display: inline-flex;
    gap: 5px;
    line-height: 1.3;
  }

  .project-link-icon {
    flex: 0 0 auto;
  }

  @media (width <= 700px) {
    .project-list {
      gap: 1.5rem;
      grid-template-columns: 1fr;
    }

    .project-item:not(.featured) {
      grid-column: auto;
    }

    article {
      border: none;
      box-shadow: 0 1px 1px #f2f2f2;
      padding: 0 0 18px 0;
    }
  }

  @media print {
    .project-list {
      display: flex;
      flex-direction: column;
      margin-inline: 0;
    }
  }
</style>
