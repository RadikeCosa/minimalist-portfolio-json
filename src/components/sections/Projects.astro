---
import Section from "../Section.astro";
import { getLangFromUrl, useTranslations, getCV } from "@/i18n/utils";
import type { Language } from "@/i18n/types";
import ActionIcon from "@/components/ActionIcon.astro";

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const cvData = await getCV(currentLang);

// Usar los datos del CV según el idioma actual
const { projects } = cvData;
---

<Section id="projects" title={t("section.projects")}>
  <ul class="project-list">
    {
      projects.map(
        ({ url, description, highlights, name, featured, badge, github, caseStudyUrl, image }) => {
          return (
            <li class:list={["project-item", { featured }]}>
              <article>
                {image && (caseStudyUrl ? (
                  <a
                    class="project-preview-link"
                    href={caseStudyUrl}
                    aria-label={`${t("project.caseStudyTitle")} ${name}`}
                  >
                    <img class="project-preview" src={image} alt="" loading="lazy" decoding="async" />
                  </a>
                ) : (
                  <img class="project-preview" src={image} alt="" loading="lazy" decoding="async" />
                ))}
                <header>
                  {badge && <p class="project-badge">{badge}</p>}
                  <h3>{name}</h3>
                  <p>{description}</p>
                </header>
                <footer>
                  <ul class="project-stack" aria-label={t("project.stackLabel")}>
                    {highlights.map((highlight) => {
                      return <li>{highlight}</li>;
                    })}
                  </ul>
                  <nav class="project-actions" aria-label={name}>
                    {caseStudyUrl && (
                      <a
                        class="project-case-link"
                        href={caseStudyUrl}
                        title={`${t("project.caseStudyTitle")} ${name}`}
                      >
                        {t("project.caseStudy")}
                      </a>
                    )}
                    {(url || github) && <div class="project-links">
                      {url && (
                        <a
                          href={url}
                          target="_blank"
                          rel="noopener noreferrer"
                          title={`${t("project.visit")} ${name}`}
                        >
                          <ActionIcon name="external" size={13} />
                          {t("project.visitLabel")}
                        </a>
                      )}
                      {github && (
                        <a
                          href={github}
                          target="_blank"
                          rel="noopener noreferrer"
                          title={`${t("project.source")} ${name}`}
                        >
                          <ActionIcon name="github" size={13} />
                          {t("project.sourceLabel")}
                        </a>
                      )}
                    </div>}
                  </nav>
                </footer>
              </article>
            </li>
          );
        }
      )
    }
  </ul>
</Section>

<style>
  .project-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.2rem, 3vw, 2.4rem);
  }

  .project-item.featured {
    grid-column: 1 / -1;
  }

  article {
    border-top: 1px solid var(--border);
    gap: 16px;
    display: flex;
    flex-direction: column;
    padding-top: 16px;
    height: 100%;
  }

  .featured article {
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
    align-items: center;
    column-gap: clamp(1.5rem, 4vw, 3.5rem);
    padding-top: 20px;
  }

  .project-preview {
    background: var(--bg-secondary);
    display: block;
    height: auto;
    max-height: 430px;
    object-fit: contain;
    object-position: top center;
    width: 100%;
  }

  .project-preview-link {
    background: var(--bg-secondary);
    border: 1px solid var(--border-light);
    border-radius: 8px;
    display: block;
    overflow: hidden;
  }

  .project-preview-link:focus-visible {
    border-radius: 8px;
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .project-preview-link .project-preview {
    transition: transform 180ms ease;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .project-preview-link:hover .project-preview {
      transform: scale(1.025);
    }
  }

  .project-item:not(.featured) .project-preview {
    aspect-ratio: 16 / 9;
    max-height: none;
  }

  .featured article header { grid-column: 1; grid-row: 1; }
  .featured article footer { grid-column: 1; grid-row: 2; }
  .featured article .project-preview-link,
  .featured article > .project-preview { grid-column: 2; grid-row: 1 / 3; }

  article header {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 7px;
  }

  .project-badge {
    align-items: center;
    color: var(--text-muted);
    display: inline-flex;
    font-size: 0.76rem;
    font-weight: 600;
    gap: 6px;
    line-height: 1.2;
    margin-bottom: 0;
    padding: 0;
  }

  .project-badge::before {
    background: var(--accent);
    border-radius: 999px;
    content: "";
    height: 5px;
    opacity: 1;
    width: 5px;
  }

  article h3 {
    font-size: clamp(1.3rem, 1.8vw, 1.8rem);
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  article a {
    color: var(--text-primary);
  }

  article a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  article a:focus-visible {
    border-radius: 4px;
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  article p {
    font-size: 0.98rem;
    line-height: 1.55;
  }

  footer {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .project-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .project-stack li {
    border-radius: 6px;
    background: var(--bg-secondary);
    color: var(--text-secondary);
    font-size: 0.74rem;
    font-weight: 500;
    line-height: 1.2;
    padding: 0.28rem 0.62rem;
  }

  .project-actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .project-case-link {
    align-self: flex-start;
    align-items: center;
    display: inline-flex;
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1.3;
    min-height: 44px;
    padding-block: 8px;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .project-links a {
    align-items: center;
    display: inline-flex;
    flex-direction: row;
    gap: 5px;
    line-height: 1.3;
    min-height: 44px;
    padding-block: 8px;
    white-space: nowrap;
  }

  @media (width <= 700px) {
    .project-list {
      gap: 2rem;
      grid-template-columns: 1fr;
    }

    .featured article {
      align-items: stretch;
      display: flex;
      flex-direction: column;
      padding-top: 16px;
    }

    .project-preview { max-height: 280px; }
    article { gap: 14px; }
  }

  @media print {
    .project-list {
      display: flex;
      flex-direction: column;
      margin-inline: 0;
    }
  }
</style>
