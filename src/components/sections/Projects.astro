---
import Section from "@/components/Section.astro";
import { getCV } from "@/i18n/utils";
import { presentProjects } from "@/content/projects";
import type { Language } from "@/i18n/types";
import type { Projects } from "@/cv";
interface Props { lang: Language }
const { lang } = Astro.props;
const en = lang === "en";
const { projects } = await getCV(lang);
const presented = presentProjects(projects as Projects[], lang);
const featured = presented.filter(p => p.level === "featured");
const secondary = presented.find(p => p.level === "secondary");
const sizes = { "family-games": [840,780], "fira-estudio": [1200,800], "clinical-app": [750,960], "rehabilitation-landing": [1440,1000] } as const;
---
<Section id="projects" title={en ? "Selected projects" : "Proyectos seleccionados"}>
  <ul class="project-grid">
    {featured.map(project => (
      <li>
        <a class:list={["project-card", "pressable", `project-${project.color}`]} href={project.caseStudyUrl} aria-labelledby={`name-${project.id}`}>
          <div class="project-heading">
            <span class="eyebrow" aria-hidden="true">{String(project.order).padStart(2,"0")}</span>
            <h3 id={`name-${project.id}`}>{project.name}</h3>
          </div>
          <div class="project-image">
            <img src={project.image} alt="" width={sizes[project.id][0]} height={sizes[project.id][1]} loading="lazy" decoding="async" />
          </div>
          <div class="project-copy">
            <p class="project-status">{project.badge}</p>
            <p>{project.contribution}</p>
            <ul class="project-stack" aria-label={en ? "Technologies" : "Tecnologías"}>{project.highlights.slice(0,4).map(item => <li>{item}</li>)}</ul>
            <span class="project-cta">{en ? "View case study" : "Ver caso de estudio"}<span aria-hidden="true">→</span></span>
          </div>
        </a>
      </li>
    ))}
  </ul>
  {secondary && (
    <article class="secondary-project">
      <img src={secondary.image} alt={en ? "Home rehabilitation website" : "Sitio de rehabilitación domiciliaria"} width="1440" height="1000" loading="lazy" decoding="async" />
      <div>
        <p class="eyebrow">{en ? "Also built" : "También desarrollé"}</p>
        <h3>{secondary.name}</h3>
        <p>{secondary.contribution}</p>
        <a class="text-link" href={secondary.caseStudyUrl}>{en ? "View case study" : "Ver caso de estudio"}</a>
      </div>
    </article>
  )}
</Section>
<style>
  .project-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 24px; }
  .project-grid > li { min-width: 0; display: flex; }
  .project-card { --press-shadow: 8px; border: 4px solid var(--ink); box-shadow: 8px 8px 0 var(--ink); display: flex; flex-direction: column; color: var(--ink); text-decoration: none; width: 100%; }
  .project-heading { display: flex; flex-direction: column; gap: 20px; min-height: 176px; padding: 24px 20px; border-bottom: 4px solid var(--ink); }
  .project-heading h3 { color: inherit; text-transform: uppercase; font-size: clamp(20px,1.8vw,25px); }
  .project-red .project-heading { background: var(--red); color: var(--paper); }
  .project-yellow .project-heading { background: var(--yellow); }
  .project-blue .project-heading { background: var(--blue); color: var(--paper); }
  .project-image { height: 220px; border-bottom: 2px solid var(--ink); padding: 16px; display: flex; justify-content: center; align-items: center; }
  .project-image img { width: 100%; height: 100%; object-fit: contain; }
  .project-copy { display: flex; flex-direction: column; flex: 1; gap: 18px; padding: 24px 20px; }
  .project-copy p { font-size: 16px; }
  .project-copy .project-status { font-size: 12px; font-weight: 600; }
  .project-stack { display: flex; flex-wrap: wrap; gap: 4px 12px; margin-top: auto; }
  .project-stack li { font-size: 12px; font-weight: 700; }
  .project-cta { display: flex; justify-content: space-between; gap: 12px; align-items: center; border-top: 2px solid var(--ink); padding-top: 16px; font-size: 14px; font-weight: 700; }
  .project-cta span { font-size: 22px; }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .project-cta span { transition: transform 120ms ease-out; }
    .project-card:hover .project-cta span { transform: translate(2px,-2px); }
  }
  .secondary-project { display: grid; grid-template-columns: 200px minmax(0,1fr); gap: 32px; align-items: center; border-block: 2px solid var(--ink); padding-block: 32px; margin-top: 48px; }
  .secondary-project img { border: 2px solid var(--ink); }
  .secondary-project > div { display: flex; flex-direction: column; gap: 12px; align-items: flex-start; }
  @media (width < 1100px) and (width >= 768px) {
    .project-grid { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 32px 24px; }
    .project-grid > li:last-child { grid-column: 1 / -1; width: calc(50% - 12px); justify-self: center; }
    .project-heading { min-height: 150px; padding: 20px 18px; gap: 14px; }
    .project-heading h3 { font-size: 21px; }
    .project-image { height: 220px; }
  }
  @media (width < 768px) { .project-card { --press-shadow: 4px; box-shadow: 4px 4px 0 var(--ink); } .project-image { height: 220px; } .secondary-project { grid-template-columns: 1fr; gap: 24px; } .secondary-project img { max-width: 320px; } }
  @media print { .project-heading { background: var(--paper) !important; color: var(--ink) !important; } .project-grid { grid-template-columns: 1fr; } .project-card { break-inside: avoid; } .project-image { height: 180px; } }
</style>
