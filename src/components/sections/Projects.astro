---
import Section from "../Section.astro";
import { getLangFromUrl, useTranslations, getCV } from "@/i18n/utils";
import type { Language } from "@/i18n/types";
import ActionIcon from "@/components/ActionIcon.astro";

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const cvData = await getCV(currentLang);

// Usar los datos del CV según el idioma actual
const { projects } = cvData;
---

<Section id="projects" title={t("section.projects")}>
  <ul class="project-list">
    {
      projects.map(
        ({ url, description, highlights, name, featured, badge, github, caseStudyUrl }) => {
          return (
            <li class:list={["project-item", { featured }]}>
              <article>
                <header>
                  {badge && <p class="project-badge">{badge}</p>}
                  <h3>{name}</h3>
                  <p>{description}</p>
                </header>
                <footer>
                  <ul class="project-stack" aria-label={t("project.stackLabel")}>
                    {highlights.map((highlight) => {
                      return <li>{highlight}</li>;
                    })}
                  </ul>
                  <nav class="project-actions" aria-label={name}>
                    {caseStudyUrl && (
                      <a
                        class="project-case-link"
                        href={caseStudyUrl}
                        title={`${t("project.caseStudyTitle")} ${name}`}
                      >
                        {t("project.caseStudy")}
                      </a>
                    )}
                    <div class="project-links">
                      <a
                        href={url}
                        target="_blank"
                        rel="noopener noreferrer"
                        title={`${t("project.visit")} ${name}`}
                      >
                        <ActionIcon name="external" size={13} />
                        {t("project.visitLabel")}
                      </a>
                      {github && (
                        <a
                          href={github}
                          target="_blank"
                          rel="noopener noreferrer"
                          title={`${t("project.source")} ${name}`}
                        >
                          <ActionIcon name="github" size={13} />
                          {t("project.sourceLabel")}
                        </a>
                      )}
                    </div>
                  </nav>
                </footer>
              </article>
            </li>
          );
        }
      )
    }
  </ul>
</Section>

<style>
  .project-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .project-item:not(.featured) {
    grid-column: 1 / -1;
  }

  article {
    border-radius: 8px;
    border: 1px solid var(--border-light);
    background: var(--bg-primary);
    gap: 18px;
    display: flex;
    flex-direction: column;
    padding: 18px;
    height: 100%;
  }

  article header {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 7px;
  }

  .project-badge {
    align-items: center;
    color: var(--text-muted);
    display: inline-flex;
    font-size: 0.68rem;
    font-weight: 600;
    gap: 6px;
    line-height: 1.2;
    margin-bottom: 0;
    padding: 0;
  }

  .project-badge::before {
    background: var(--accent);
    border-radius: 999px;
    content: "";
    height: 5px;
    opacity: 1;
    width: 5px;
  }

  article h3 {
    font-size: 1.05rem;
    line-height: 1.35;
  }

  article a {
    color: var(--text-primary);
  }

  article a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  article a:focus-visible {
    border-radius: 4px;
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  article p {
    font-size: 0.8rem;
    line-height: 1.5;
  }

  footer {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .project-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }

  .project-stack li {
    border-radius: 6px;
    background: var(--bg-secondary);
    color: var(--text-secondary);
    font-size: 0.65rem;
    font-weight: 500;
    line-height: 1.2;
    padding: 0.22rem 0.62rem;
  }

  .project-actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .project-case-link {
    align-self: flex-start;
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .project-links a {
    align-items: center;
    display: inline-flex;
    flex-direction: row;
    gap: 5px;
    line-height: 1.3;
    white-space: nowrap;
  }

  @media (width <= 700px) {
    .project-list {
      gap: 1.5rem;
      grid-template-columns: 1fr;
    }

    .project-item:not(.featured) {
      grid-column: auto;
    }

    article {
      border: none;
      box-shadow: 0 1px 1px var(--border-light);
      padding: 0 0 18px 0;
    }
  }

  @media print {
    .project-list {
      display: flex;
      flex-direction: column;
      margin-inline: 0;
    }
  }
</style>
