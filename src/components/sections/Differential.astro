---
import Section from "@/components/Section.astro";
import { getHomeContent } from "@/content/home";
import type { Language } from "@/i18n/types";
interface Props { lang: Language }
const { lang } = Astro.props;
const { differential } = getHomeContent(lang);
---
<Section id="approach" title={differential.title}>
  <ol class="method-list">
    {differential.items.map((item,i) => <li><span aria-hidden="true">{String(i+1).padStart(2,"0")}</span><div><h3>{item.title}</h3><p>{item.description}</p></div></li>)}
  </ol>
</Section>
<style>
  .method-list { padding: 0; list-style: none; counter-reset: step; }
  li { display: grid; grid-template-columns: 60px 1fr; gap: 24px; border-top: 2px solid var(--ink); padding: 24px 0; }
  li:last-child { border-bottom: 2px solid var(--ink); }
  li > span { font-size: 32px; font-weight: 800; }
  li > div { display: grid; grid-template-columns: minmax(180px,1fr) minmax(0,2fr); gap: 24px; }
  p { max-width: 60ch; }
  @media (width < 768px) { li { grid-template-columns: 32px 1fr; gap: 16px; } li > span { font-size: 24px; } li > div { grid-template-columns: 1fr; gap: 12px; } }
</style>
