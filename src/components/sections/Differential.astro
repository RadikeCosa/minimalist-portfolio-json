---
import Section from "../Section.astro";
import { getLangFromUrl } from "@/i18n/utils";
import type { Language } from "@/i18n/types";
import { getHomeContent } from "@/content/home";

interface Props { lang?: Language; }
const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const { differential } = getHomeContent(currentLang);
---

<Section id="differential" title={differential.title}>
  <ul>
    {differential.items.map((item) => (
      <li><h3>{item.title}</h3><p>{item.description}</p></li>
    ))}
  </ul>
</Section>

<style>
  ul { display: grid; gap: 24px; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  li { border-top: 1px solid var(--border); padding-top: 16px; }
  h3 { font-size: 1.08rem; line-height: 1.3; margin-bottom: 10px; }
  li p { font-size: 0.96rem; line-height: 1.55; }
  @media (width <= 700px) { ul { grid-template-columns: 1fr; } }
</style>
