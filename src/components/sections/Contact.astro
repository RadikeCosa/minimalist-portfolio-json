---
import Section from "@/components/Section.astro";
import { getCV } from "@/i18n/utils";
import { getHomeContent } from "@/content/home";
import type { Language } from "@/i18n/types";
interface Props { lang: Language }
const { lang } = Astro.props;
const en = lang === "en";
const { contact } = getHomeContent(lang);
const { basics } = await getCV(lang);
const cvHref = en ? "/cv/CV_Ramiro_Nicolas_Cosa_EN.pdf" : "/cv/CV_Ramiro_Nicolas_Cosa.pdf";
const emailHref = `mailto:${basics.email}?subject=${encodeURIComponent(contact.emailSubject)}`;
const profiles = ["LinkedIn", "GitHub"].map(network => basics.profiles.find(p => p.network === network)).filter(p => p !== undefined);
---
<Section id="contact" title={contact.title}>
  <div class="contact-layout">
    <p>{contact.description}</p>
    <div class="contact-actions">
      <a class="button button-primary" href={emailHref}>{contact.emailAction}</a>
      <nav class="contact-links" aria-label={en ? "Professional profiles and CV" : "Perfiles profesionales y CV"}>
        {profiles.map(profile => <a href={profile.url} target="_blank" rel="noopener noreferrer">{profile.network}<span class="sr-only">{en ? " (opens in a new tab)" : " (abre una pestaña nueva)"}</span></a>)}
        <a href={cvHref} download>{contact.cvAction}</a>
      </nav>
      <address><a href={`tel:${basics.phone.replace(/[^\d+]/g, "")}`}>{basics.phone}</a></address>
    </div>
  </div>
</Section>
<style>
  .contact-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; border-top: 2px solid var(--ink); padding-top: 32px; }
  .contact-layout > p { max-width: 52ch; }
  .contact-actions { display: flex; flex-direction: column; align-items: flex-start; gap: 24px; }
  .contact-links { display: flex; flex-wrap: wrap; gap: 8px 24px; }
  .contact-links a,address a { display: inline-flex; align-items: center; min-height: 44px; font-size: 14px; font-weight: 600; }
  address { font-style: normal; }
  @media (width < 768px) { .contact-layout { grid-template-columns: 1fr; gap: 24px; } }
</style>
