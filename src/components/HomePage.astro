---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/sections/Hero.astro";
import Projects from "@/components/sections/Projects.astro";
import Differential from "@/components/sections/Differential.astro";
import Personal from "@/components/sections/Personal.astro";
import Skills from "@/components/sections/Skills.astro";
import Contact from "@/components/sections/Contact.astro";
import type { Language } from "@/i18n/types";
interface Props { lang: Language }
const { lang } = Astro.props;
const en = lang === "en";
---
<Layout title={en ? "Ramiro Nicolás Cosa | Web development & functional analysis" : "Ramiro Nicolás Cosa | Desarrollo web y análisis funcional"} description={en ? "I build web products, from understanding the problem to implementation. Selected projects, functional analysis, and healthcare experience." : "Desarrollo productos web, desde entender el problema hasta la implementación. Proyectos seleccionados, análisis funcional y experiencia en salud."} lang={lang} alternateUrl={en ? "/" : "/en/"} isHome>
  <main id="main-content">
    <Hero lang={lang} />
    <Projects lang={lang} />
    <Differential lang={lang} />
    <Personal lang={lang} />
    <Skills lang={lang} />
    <Contact lang={lang} />
  </main>
</Layout>
