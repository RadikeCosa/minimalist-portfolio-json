---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/sections/Hero.astro";
import Projects from "@/components/sections/Projects.astro";
import Differential from "@/components/sections/Differential.astro";
import Personal from "@/components/sections/Personal.astro";
import Skills from "@/components/sections/Skills.astro";
import Contact from "@/components/sections/Contact.astro";
import type { Language } from "@/i18n/types";
interface Props { lang: Language }
const { lang } = Astro.props;
const en = lang === "en";
---
<Layout title={en ? "Ramiro Nicolás Cosa | Web developer in Neuquén" : "Programador en Neuquén | Ramiro Nicolás Cosa"} description={en ? "Web developer based in Neuquén, Argentina. Websites, product catalogues and custom web applications, with functional analysis and healthcare experience." : "Soy Ramiro Cosa, programador en Neuquén. Desarrollo sitios web, catálogos y aplicaciones a medida. Conocé mis proyectos y contame qué necesitás."} lang={lang} alternateUrl={en ? "/" : "/en/"} isHome>
  <main tabindex="-1" id="main-content">
    <Hero lang={lang} />
    <Projects lang={lang} />
    <Differential lang={lang} />
    <Personal lang={lang} />
    <Skills lang={lang} />
    <Contact lang={lang} />
  </main>
</Layout>
