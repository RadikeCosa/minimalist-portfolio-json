---
import { getLangFromUrl, getCV } from "@/i18n/utils";
import type { Language } from "@/i18n/types";
import "@/styles/fonts.css";
import archivoLatin from "@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url";
import "@/styles/global.css";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";

interface Props {
  title: string;
  description?: string;
  lang?: Language;
  alternateUrl?: string;
  isHome?: boolean;
  isProfile?: boolean;
  isService?: boolean;
  isProject?: boolean;
}

const {
  title,
  description,
  lang,
  alternateUrl,
  isHome = false,
  isProfile = false,
  isService = false,
  isProject = false,
} = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);

// Obtener CV según el idioma
const cvData = await getCV(currentLang);
const { name, summary, url, profiles, location } = cvData.basics;
const pageDescription = description || summary;
const baseUrl = Astro.site || new URL(url);
const siteUrl = new URL("/", baseUrl).toString();
const canonicalUrl = new URL(Astro.url.pathname, baseUrl).toString();
const alternateHref = alternateUrl ? new URL(alternateUrl, baseUrl).toString() : null;
const alternateLang = currentLang === "en" ? "es" : "en";
const defaultHref = currentLang === "es" ? canonicalUrl : alternateHref;
const socialImage = new URL(
  currentLang === "en" ? "/og/portfolio-en.png?v=bauhaus-2" : "/og/portfolio-es.png?v=bauhaus-2",
  baseUrl,
).toString();
const personEntity = {
  "@type": "Person",
  "@id": `${siteUrl}#person`,
  name,
  url: siteUrl,
  jobTitle:
    currentLang === "en"
      ? "Web development and functional analysis"
      : "Desarrollo web y análisis funcional",
  description: isHome ? pageDescription : summary,
  sameAs: profiles.map(({ url }) => url),
  knowsAbout:
    currentLang === "en"
      ? ["Functional analysis", "Digital products", "Web development", "Healthcare operations", "HealthTech"]
      : ["Análisis funcional", "Productos digitales", "Desarrollo web", "Operaciones de salud", "HealthTech"],
  address: {
    "@type": "PostalAddress",
    addressLocality: location.city,
    addressRegion: location.city,
    addressCountry: location.countryCode,
  },
};
const pageEntity = isService
  ? {
      "@type": "Service",
      "@id": `${canonicalUrl}#service`,
      name: title,
      description: pageDescription,
      url: canonicalUrl,
      inLanguage: currentLang,
      provider: { "@id": `${siteUrl}#person` },
    }
  : isProject
    ? {
        "@type": "CreativeWork",
        "@id": `${canonicalUrl}#project`,
        name: title,
        description: pageDescription,
        url: canonicalUrl,
        inLanguage: currentLang,
        creator: { "@id": `${siteUrl}#person` },
      }
    : null;
const structuredData = isHome
  ? {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": `${siteUrl}#website`,
          url: siteUrl,
          name,
          alternateName: [`Portfolio de ${name}`, `${name} Portfolio`],
          inLanguage: ["es", "en"],
          publisher: { "@id": `${siteUrl}#person` },
        },
        personEntity,
      ],
    }
  : isProfile
    ? {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "ProfilePage",
            "@id": `${canonicalUrl}#profile-page`,
            url: canonicalUrl,
            name: title,
            description: pageDescription,
            inLanguage: currentLang,
            isPartOf: { "@id": `${siteUrl}#website` },
            mainEntity: { "@id": `${siteUrl}#person` },
          },
          personEntity,
        ],
      }
    : pageEntity
      ? {
          "@context": "https://schema.org",
          "@graph": [pageEntity, personEntity],
        }
      : null;
const structuredDataJson = structuredData
  ? JSON.stringify(structuredData).replace(/</g, "\\u003c")
  : null;
---

<!doctype html>
<html lang={currentLang}>
  <head>
    <meta charset="UTF-8" />
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin="anonymous" />
    <title>{title}</title>
    <meta name="description" content={pageDescription} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F0F0F0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=bauhaus-2" />
    <link rel="canonical" href={canonicalUrl} />
    {
      alternateHref && (
        <>
          <link rel="alternate" hreflang={currentLang} href={canonicalUrl} />
          <link rel="alternate" hreflang={alternateLang} href={alternateHref} />
          {defaultHref && <link rel="alternate" hreflang="x-default" href={defaultHref} />}
        </>
      )
    }

    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={isProfile ? "profile" : "website"} />
    <meta property="og:site_name" content={name} />
    <meta property="og:locale" content={currentLang === "en" ? "en_US" : "es_AR"} />
    <meta property="og:locale:alternate" content={currentLang === "en" ? "es_AR" : "en_US"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={currentLang === "en" ? `${name} portfolio: web development and functional analysis` : `Portfolio de ${name}: desarrollo web y análisis funcional`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content={new URL(url).hostname} />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={currentLang === "en" ? `${name} portfolio: web development and functional analysis` : `Portfolio de ${name}: desarrollo web y análisis funcional`} />
    {structuredDataJson && <script is:inline type="application/ld+json" set:html={structuredDataJson} />}
  </head>
  <body>
    <a class="skip-link no-print" href="#main-content">
      {currentLang === "en" ? "Skip to main content" : "Saltar al contenido principal"}
    </a>
    <div class="site-frame">
      <SiteHeader lang={currentLang} />
      <slot />
      <SiteFooter lang={currentLang} />
    </div>
  </body>
</html>
