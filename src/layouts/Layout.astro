---
import { getLangFromUrl, getCV } from "@/i18n/utils";
import type { Language } from "@/i18n/types";

interface Props {
  title: string;
  description?: string;
  lang?: Language;
  alternateUrl?: string;
}

const { title, description, lang, alternateUrl } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);

// Obtener CV según el idioma
const cvData = await getCV(currentLang);
const { summary, url } = cvData.basics;
const pageDescription = description || summary;
const canonicalUrl = new URL(Astro.url.pathname, url).toString();
const alternateHref = alternateUrl ? new URL(alternateUrl, url).toString() : null;
const alternateLang = currentLang === "en" ? "es" : "en";
const defaultHref = currentLang === "es" ? canonicalUrl : alternateHref;
const socialImage = "";
const hasSocialImage = socialImage.trim().length > 0;
---

<!doctype html>
<html lang={currentLang}>
  <meta charset="UTF-8" />
  <head>
    <title>{title}</title>
    <meta name="description" content={pageDescription} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    {
      alternateHref && (
        <>
          <link rel="alternate" hreflang={currentLang} href={canonicalUrl} />
          <link rel="alternate" hreflang={alternateLang} href={alternateHref} />
          {defaultHref && <link rel="alternate" hreflang="x-default" href={defaultHref} />}
        </>
      )
    }

    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={pageDescription} />
    {hasSocialImage && <meta property="og:image" content={socialImage} />}

    <meta name="twitter:card" content={hasSocialImage ? "summary_large_image" : "summary"} />
    <meta property="twitter:domain" content={new URL(url).hostname} />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={pageDescription} />
    {hasSocialImage && <meta name="twitter:image" content={socialImage} />}
    <script is:inline>
      (function () {
        const theme =
          localStorage.getItem("theme") ||
          (window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light");
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
  <style is:global>
    :root {
      /* Light theme */
      --bg-primary: #ffffff;
      --bg-secondary: #f8f9fa;
      --bg-hover: #e9ecef;
      --text-primary: #111111;
      --text-secondary: #666666;
      --text-muted: #555555;
      --border: #e0e0e0;
      --border-light: #f2f2f2;
      --accent: #0066cc;
    }

    [data-theme="dark"] {
      --bg-primary: #1a1a1a;
      --bg-secondary: #2d2d2d;
      --bg-hover: #404040;
      --text-primary: #ffffff;
      --text-secondary: #cccccc;
      --text-muted: #aaaaaa;
      --border: #404040;
      --border-light: #333333;
      --accent: #4d9fff;
    }

    html {
      font-family:
        Menlo,
        Monaco,
        Lucida Console,
        "Courier New",
        Courier,
        monospace;
      background: var(--bg-primary);
      color: var(--text-primary);
      letter-spacing: -0.025rem;
      transition:
        background-color 0.3s ease,
        color 0.3s ease;
    }

    body,
    figure {
      margin: 0;
      padding: 0;
    }

    a {
      text-decoration: none;
    }

    ul {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    *,
    *::before,
    *::after {
      box-sizing: border-box;
    }

    h1,
    h2,
    h3,
    h4 {
      margin: 0;
      font-family:
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Roboto,
        Oxygen,
        Ubuntu,
        Cantarell,
        "Open Sans",
        "Helvetica Neue",
        sans-serif;
      color: var(--text-primary);
    }

    p {
      color: var(--text-secondary);
      font-size: 0.9rem;
      line-height: 1.5;
      margin: 0;
      text-wrap: pretty;
    }

    .print {
      display: none !important;
    }

    @media print {
      .no-print {
        display: none !important;
      }

      .print {
        display: block !important;
      }

      astro-dev-toolbar {
        display: none !important;
      }

      article {
        break-inside: avoid;
      }
    }
  </style>
</html>
