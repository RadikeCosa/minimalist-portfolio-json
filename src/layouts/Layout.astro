---
import { getLangFromUrl, getCV } from "@/i18n/utils";
import type { Language } from "@/i18n/types";
import "@fontsource-variable/ibm-plex-sans/wght.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/600.css";

interface Props {
  title: string;
  description?: string;
  lang?: Language;
  alternateUrl?: string;
  isHome?: boolean;
  isProfile?: boolean;
  isService?: boolean;
  isProject?: boolean;
}

const {
  title,
  description,
  lang,
  alternateUrl,
  isHome = false,
  isProfile = false,
  isService = false,
  isProject = false,
} = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);

// Obtener CV según el idioma
const cvData = await getCV(currentLang);
const { name, summary, url, profiles, location } = cvData.basics;
const pageDescription = description || summary;
const baseUrl = Astro.site || new URL(url);
const siteUrl = new URL("/", baseUrl).toString();
const canonicalUrl = new URL(Astro.url.pathname, baseUrl).toString();
const alternateHref = alternateUrl ? new URL(alternateUrl, baseUrl).toString() : null;
const alternateLang = currentLang === "en" ? "es" : "en";
const defaultHref = currentLang === "es" ? canonicalUrl : alternateHref;
const socialImage = new URL(
  currentLang === "en" ? "/og/portfolio-en.png" : "/og/portfolio-es.png",
  baseUrl,
).toString();
const personEntity = {
  "@type": "Person",
  "@id": `${siteUrl}#person`,
  name,
  url: siteUrl,
  jobTitle:
    currentLang === "en"
      ? "Digital product analysis, development, and implementation"
      : "Análisis, desarrollo e implementación de productos digitales",
  description: isHome ? pageDescription : summary,
  sameAs: profiles.map(({ url }) => url),
  knowsAbout:
    currentLang === "en"
      ? ["Functional analysis", "Digital products", "Web development", "Healthcare operations", "HealthTech"]
      : ["Análisis funcional", "Productos digitales", "Desarrollo web", "Operaciones de salud", "HealthTech"],
  address: {
    "@type": "PostalAddress",
    addressLocality: location.city,
    addressRegion: location.city,
    addressCountry: location.countryCode,
  },
};
const pageEntity = isService
  ? {
      "@type": "Service",
      "@id": `${canonicalUrl}#service`,
      name: title,
      description: pageDescription,
      url: canonicalUrl,
      inLanguage: currentLang,
      provider: { "@id": `${siteUrl}#person` },
    }
  : isProject
    ? {
        "@type": "CreativeWork",
        "@id": `${canonicalUrl}#project`,
        name: title,
        description: pageDescription,
        url: canonicalUrl,
        inLanguage: currentLang,
        creator: { "@id": `${siteUrl}#person` },
      }
    : null;
const structuredData = isHome
  ? {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": `${siteUrl}#website`,
          url: siteUrl,
          name,
          alternateName: [`Portfolio de ${name}`, `${name} Portfolio`],
          inLanguage: ["es", "en"],
          publisher: { "@id": `${siteUrl}#person` },
        },
        personEntity,
      ],
    }
  : isProfile
    ? {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "ProfilePage",
            "@id": `${canonicalUrl}#profile-page`,
            url: canonicalUrl,
            name: title,
            description: pageDescription,
            inLanguage: currentLang,
            isPartOf: { "@id": `${siteUrl}#website` },
            mainEntity: { "@id": `${siteUrl}#person` },
          },
          personEntity,
        ],
      }
    : pageEntity
      ? {
          "@context": "https://schema.org",
          "@graph": [pageEntity, personEntity],
        }
      : null;
const structuredDataJson = structuredData
  ? JSON.stringify(structuredData).replace(/</g, "\\u003c")
  : null;
---

<!doctype html>
<html lang={currentLang}>
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="description" content={pageDescription} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    {
      alternateHref && (
        <>
          <link rel="alternate" hreflang={currentLang} href={canonicalUrl} />
          <link rel="alternate" hreflang={alternateLang} href={alternateHref} />
          {defaultHref && <link rel="alternate" hreflang="x-default" href={defaultHref} />}
        </>
      )
    }

    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={isProfile ? "profile" : "website"} />
    <meta property="og:site_name" content={name} />
    <meta property="og:locale" content={currentLang === "en" ? "en_US" : "es_AR"} />
    <meta property="og:locale:alternate" content={currentLang === "en" ? "es_AR" : "en_US"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={currentLang === "en" ? `${name} portfolio: digital product analysis, development, and implementation` : `Portfolio de ${name}: análisis, desarrollo e implementación de productos digitales`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content={new URL(url).hostname} />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={currentLang === "en" ? `${name} portfolio: digital product analysis, development, and implementation` : `Portfolio de ${name}: análisis, desarrollo e implementación de productos digitales`} />
    {structuredDataJson && <script is:inline type="application/ld+json" set:html={structuredDataJson} />}
    <script is:inline>
      (function () {
        const theme =
          localStorage.getItem("theme") ||
          (window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light");
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
    <style is:global>
    :root {
      /* Light theme */
      --bg-primary: #f8faf9;
      --bg-secondary: #edf2ef;
      --bg-hover: #e1eae5;
      --text-primary: #16221e;
      --text-secondary: #43534c;
      --text-muted: #52625b;
      --border: #cbd7d0;
      --border-light: #dce5df;
      --accent: #136b5c;
      --accent-contrast: #ffffff;
      --font-sans: "IBM Plex Sans Variable", "Noto Sans", sans-serif;
      --font-mono: "IBM Plex Mono", "Noto Sans Mono", monospace;
    }

    [data-theme="dark"] {
      --bg-primary: #111916;
      --bg-secondary: #202b26;
      --bg-hover: #2d3b34;
      --text-primary: #edf4f0;
      --text-secondary: #c1cdc6;
      --text-muted: #aebcb4;
      --border: #46564e;
      --border-light: #34423b;
      --accent: #72c7b5;
      --accent-contrast: #111916;
    }

    html {
      font-family: var(--font-sans);
      background: var(--bg-primary);
      color: var(--text-primary);
      letter-spacing: -0.01em;
      text-rendering: optimizeLegibility;
      -webkit-font-smoothing: antialiased;
    }

    body,
    figure {
      margin: 0;
      padding: 0;
    }

    body { min-width: 320px; }

    code, pre, kbd, samp,
    .stage-meta, .case-meta, .project-badge, .project-stack,
    .case-stack, .context, .language-toggle {
      font-family: var(--font-mono);
    }

    a {
      text-decoration: none;
    }

    ul {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    *,
    *::before,
    *::after {
      box-sizing: border-box;
    }

    .skip-link {
      background: var(--bg-primary);
      border: 2px solid var(--accent);
      border-radius: 6px;
      color: var(--text-primary);
      font-size: 0.8rem;
      font-weight: 700;
      left: 1rem;
      padding: 0.65rem 0.8rem;
      position: fixed;
      top: 1rem;
      transform: translateY(-200%);
      transition: transform 0.15s ease;
      z-index: 2000;
    }

    .skip-link:focus {
      outline: none;
      transform: translateY(0);
    }

    h1,
    h2,
    h3,
    h4 {
      margin: 0;
      font-family: var(--font-sans);
      color: var(--text-primary);
    }

    p {
      color: var(--text-secondary);
      font-size: 1rem;
      line-height: 1.65;
      margin: 0;
      text-wrap: pretty;
    }

    .print {
      display: none !important;
    }

    @media print {
      .no-print {
        display: none !important;
      }

      .print {
        display: block !important;
      }

      astro-dev-toolbar {
        display: none !important;
      }

      article {
        break-inside: avoid;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *,
      *::before,
      *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        scroll-behavior: auto !important;
        transition-duration: 0.01ms !important;
      }
    }
    </style>
  </head>
  <body>
    <a class="skip-link no-print" href="#main-content">
      {currentLang === "en" ? "Skip to main content" : "Saltar al contenido principal"}
    </a>
    <slot />
  </body>
</html>
