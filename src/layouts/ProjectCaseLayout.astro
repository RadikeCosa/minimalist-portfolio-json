---
import Layout from "@/layouts/Layout.astro";
import { getCV, getLangFromUrl } from "@/i18n/utils";
import type { Language } from "@/i18n/types";
import ActionIcon from "@/components/ActionIcon.astro";
import { imageDimensions } from "@/content/image-dimensions";
import { projectPresentation } from "@/content/projects";
import type { Projects } from "@/cv";

interface ProjectCaseFrontmatter {
  title: string;
  description?: string;
  locale?: Language;
  alternateUrl?: string;
  role?: string;
  status?: string;
  problem?: string;
  contribution?: string;
  decision?: string;
  period?: string;
  stack?: string[];
  website?: string;
  websiteLabel?: string;
  repository?: string;
  coverImage?: string;
  coverImageAlt?: string;
  coverImageCaption?: string;
}

const frontmatter = (Astro.props.frontmatter ?? Astro.props) as ProjectCaseFrontmatter;
const coverSize = frontmatter.coverImage ? imageDimensions[frontmatter.coverImage] : undefined;
const currentLang = frontmatter.locale || getLangFromUrl(Astro.url);
const isEnglish = currentLang === "en";
const { projects } = await getCV(currentLang);
const project = (projects as Projects[]).find(project => project.caseStudyUrl?.replace(/\/$/, "") === Astro.url.pathname.replace(/\/$/, ""));
const presentation = project ? projectPresentation[project.id] : undefined;
const accent = presentation?.color ?? "neutral";
const accentColor = accent === "neutral" ? "ink" : accent;
const pageTitle = isEnglish
  ? `${frontmatter.title} | Ramiro Nicolás Cosa`
  : `${frontmatter.title} | Ramiro Nicolás Cosa`;
const backHref = isEnglish ? "/en/#projects" : "/#projects";
const backLabel = isEnglish ? "Back to projects" : "Volver a proyectos";
const metaItems = [frontmatter.role, frontmatter.period].filter(Boolean);
const externalLinks = [
  frontmatter.website && {
    href: frontmatter.website,
    label: frontmatter.websiteLabel || (isEnglish ? "Live site" : "Sitio"),
    icon: "external" as const,
  },
  frontmatter.repository && {
    href: frontmatter.repository,
    label: isEnglish ? "Source" : "Código",
    icon: "github" as const,
  },
].filter(Boolean) as Array<{ href: string; label: string; icon: "external" | "github" }>;
---

<Layout
  title={pageTitle}
  description={frontmatter.description}
  lang={currentLang}
  alternateUrl={frontmatter.alternateUrl}
  isProject
>
  <main tabindex="-1" id="main-content" class="reading-page case-page" style={`--case-accent: var(--${accentColor}); --case-heading: var(--${accent === "yellow" ? "ink" : accentColor}); --case-on-accent: var(--${accent === "yellow" ? "ink" : "paper"});`}>
    <nav class="back no-print" aria-label={isEnglish ? "Project navigation" : "Navegación de proyecto"}>
      <a href={backHref}><ActionIcon name="back" />{backLabel}</a>
    </nav>

    <article class="case-article">
      <header class="reading-header case-header">
        {presentation && <p class="case-label"><span class="case-number" aria-hidden="true">{String(presentation.order).padStart(2,"0")}</span><span class="eyebrow">{isEnglish ? "Case study" : "Caso de estudio"}</span></p>}
        <h1><span class="decorative-title">{frontmatter.title}</span></h1>
        {frontmatter.description && <p class="case-description">{frontmatter.description}</p>}

        {
          (metaItems.length > 0 || frontmatter.stack?.length || externalLinks.length > 0) && (
            <div class="case-meta" role="group" aria-label={isEnglish ? "Project details" : "Detalles del proyecto"}>
              {metaItems.length > 0 && (
                <p>
                  {metaItems.map((item, index) => (
                    <>
                      {index > 0 && <span aria-hidden="true"> · </span>}
                      <span>{item}</span>
                    </>
                  ))}
                </p>
              )}

              {frontmatter.stack && frontmatter.stack.length > 0 && (
                <ul class="case-stack" aria-label={isEnglish ? "Technologies" : "Tecnologías"}>
                  {frontmatter.stack.map((item) => <li><span class="case-tech-marker" aria-hidden="true"></span><span class="decorative-title">{item}</span></li>)}
                </ul>
              )}

              {externalLinks.length > 0 && (
                <nav class="case-links" aria-label={isEnglish ? "Project links" : "Links del proyecto"}>
                  {externalLinks.map((link) => (
                    <a href={link.href} target="_blank" rel="noopener noreferrer">
                      <ActionIcon name={link.icon} size={14} />
                      {link.label}
                    </a>
                  ))}
                </nav>
              )}
            </div>
          )
        }
      </header>

      {
        (frontmatter.status || frontmatter.problem || frontmatter.contribution || frontmatter.decision) && (
          <section class="case-summary" aria-label={isEnglish ? "Case summary" : "Resumen del caso"}>
            {frontmatter.status && <p class="case-status">{frontmatter.status}</p>}
            <dl>
              {frontmatter.problem && <div><dt class="summary-problem"><span class="decorative-title">{isEnglish ? "Problem" : "Problema"}</span></dt><dd>{frontmatter.problem}</dd></div>}
              {frontmatter.contribution && <div><dt class="summary-contribution"><span class="decorative-title">{isEnglish ? "Contribution" : "Aporte"}</span></dt><dd>{frontmatter.contribution}</dd></div>}
              {frontmatter.decision && <div><dt><span class="decorative-title">{isEnglish ? "Key decision" : "Decisión clave"}</span></dt><dd>{frontmatter.decision}</dd></div>}
            </dl>
          </section>
        )
      }

      {frontmatter.coverImage && (
        <figure class="case-cover">
          <img src={frontmatter.coverImage} alt={frontmatter.coverImageAlt || ""} width={coverSize?.[0]} height={coverSize?.[1]} loading="lazy" decoding="async" />
          {frontmatter.coverImageCaption && <figcaption>{frontmatter.coverImageCaption}</figcaption>}
        </figure>
      )}

      <div class="case-content">
        <slot />
      </div>

      <footer class="case-footer no-print">
        <nav aria-label={isEnglish ? "Next steps" : "Siguientes pasos"}>
          <a href={isEnglish ? "/en/#contact" : "/#contact"}><ActionIcon name="email" />{isEnglish ? "Contact" : "Contacto"}</a>
          <a href={backHref}><ActionIcon name="back" />{isEnglish ? "Back to projects" : "Volver a proyectos"}</a>
        </nav>
      </footer>
    </article>
  </main>

</Layout>

<style>
  .case-article { max-width: 1040px; margin-inline: auto; display: flex; flex-direction: column; gap: 40px; }
  .case-header,.case-summary,.case-footer { width: 100%; max-width: 760px; margin-inline: auto; }
  .case-description { font-size: 20px; line-height: 1.6; }
  .case-label { display: flex; gap: 16px; align-items: center; }
  .case-number { display: grid; place-items: center; min-width: 44px; min-height: 44px; padding: 4px; background: var(--case-accent); color: var(--case-on-accent); font-size: 20px; font-weight: 800; }
  .case-meta { display: flex; flex-direction: column; gap: 16px; }
  .case-meta p { font-size: 14px; font-weight: 600; }
  .case-stack { display: flex; flex-wrap: wrap; gap: 8px 20px; }
  .case-stack li { display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 700; }
  .case-tech-marker { flex: 0 0 auto; width: 10px; height: 10px; border: 2px solid var(--ink); background: var(--case-accent); }
  .case-links { display: flex; flex-wrap: wrap; gap: 12px 24px; }
  .case-links a,.case-footer a { display: inline-flex; gap: 8px; align-items: center; min-height: 44px; font-size: 14px; font-weight: 700; }
  .case-summary { border-block: 2px solid var(--ink); padding-block: 24px; }
  .case-status { border-left: 4px solid var(--ink); padding-left: 12px; font-size: 14px; font-weight: 700; margin-bottom: 24px; }
  .case-summary dl { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin: 0; }
  .case-summary dl > div:last-child { grid-column: 1 / -1; }
  .case-summary dt { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; margin-bottom: 8px; }
  .case-summary dd { margin: 0; }
  .summary-problem { color: var(--red); }
  .summary-contribution { color: var(--blue); }
  .case-cover { width: 100%; }
  .case-cover img { width: 100%; max-height: 640px; object-fit: contain; border: 2px solid var(--ink); }
  .case-cover figcaption { font-size: 14px; line-height: 1.6; margin-top: 12px; }
  .case-content { display: flex; flex-direction: column; gap: 20px; min-width: 0; }
  .case-content > :global(*) { width: 100%; max-width: 760px; margin-inline: auto; }
  .case-content :global(h2) { color: var(--case-heading); margin-top: 32px; padding-top: 24px; border-top: 2px solid var(--ink); }
  .case-content :global(h3) { margin-top: 12px; }
  .case-content :global(ul),.case-content :global(ol) { padding-left: 24px; list-style: disc; }
  .case-content :global(ol) { list-style: decimal; }
  .case-content :global(li + li) { margin-top: 8px; }
  .case-content :global(a) { font-weight: 600; overflow-wrap: anywhere; }
  .case-content :global(code) { font-family: inherit; font-size: .95em; font-weight: 600; overflow-wrap: anywhere; }
  .case-content :global(figure),.case-content :global(.wide) { max-width: 1040px; margin-block: 24px; }
  .case-content :global(img) { border: 2px solid var(--ink); }
  .case-content :global(figcaption) { font-size: 14px; line-height: 1.6; margin-top: 12px; }
  .case-content :global(.case-figure--screen) { max-width: 340px; }
  .case-content :global(.case-state-pair__grid) { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; max-width: 820px; margin-inline: auto; }
  .case-content :global(.case-state-pair__grid img) { width: 100%; }
  .case-content :global(.case-flow) { padding-block: 24px; border-block: 2px solid var(--ink); margin-block: 20px; }
  .case-content :global(.case-flow__steps) { list-style: none; padding: 0; display: flex; gap: 16px; align-items: center; }
  .case-content :global(.case-flow__steps li) { flex: 1; display: flex; justify-content: space-between; gap: 12px; font-size: 14px; font-weight: 600; }
  .case-content :global(.case-flow__steps li + li) { margin: 0; }
  .case-content :global(.case-decisions) { display: flex; flex-direction: column; gap: 24px; }
  .case-content :global(.case-decision) { border-left: 2px solid var(--ink); padding-left: 24px; }
  .case-content :global(.case-decision h3) { margin: 0 0 12px; }
  .case-content :global(.case-decision p + p) { margin-top: 16px; }
  .case-footer { border-top: 2px solid var(--ink); padding-top: 24px; }
  .case-footer nav { display: flex; flex-wrap: wrap; gap: 12px 24px; }
  @media (width < 768px) {
    .case-article { gap: 32px; }
    .case-summary dl { grid-template-columns: 1fr; }
    .case-summary dl > div:last-child { grid-column: auto; }
    .case-content :global(.case-state-pair__grid) { grid-template-columns: 1fr; max-width: 395px; }
    .case-content :global(.case-flow__steps) { flex-direction: column; align-items: stretch; }
    .case-content :global(.case-flow__steps li) { flex-direction: column; }
    .case-content :global(.case-flow__connector) { transform: rotate(90deg); align-self: flex-start; }
  }
  @media print {
    .case-content :global(.case-figure--screen) { max-width: 220px; }
    .case-content :global(img) { max-height: 220mm; object-fit: contain; }
    .case-number { background: var(--paper); color: var(--ink); }
    .case-content :global(h2),.case-summary dt { color: var(--ink); }
  }
</style>
