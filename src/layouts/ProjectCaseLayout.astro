---
import Layout from "@/layouts/Layout.astro";
import LanguageToggle from "@/components/LanguageToggle.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { getLangFromUrl } from "@/i18n/utils";
import type { Language } from "@/i18n/types";
import ActionIcon from "@/components/ActionIcon.astro";

interface ProjectCaseFrontmatter {
  title: string;
  description?: string;
  locale?: Language;
  alternateUrl?: string;
  role?: string;
  period?: string;
  stack?: string[];
  website?: string;
  websiteLabel?: string;
  repository?: string;
}

const frontmatter = (Astro.props.frontmatter ?? Astro.props) as ProjectCaseFrontmatter;
const currentLang = frontmatter.locale || getLangFromUrl(Astro.url);
const isEnglish = currentLang === "en";
const pageTitle = isEnglish
  ? `${frontmatter.title} | Ramiro Nicolás Cosa`
  : `${frontmatter.title} | Ramiro Nicolás Cosa`;
const backHref = isEnglish ? "/en/#projects" : "/#projects";
const backLabel = isEnglish ? "← Back to projects" : "← Volver a proyectos";
const metaItems = [frontmatter.role, frontmatter.period].filter(Boolean);
const externalLinks = [
  frontmatter.website && {
    href: frontmatter.website,
    label: frontmatter.websiteLabel || (isEnglish ? "Live site" : "Sitio"),
    icon: "external" as const,
  },
  frontmatter.repository && {
    href: frontmatter.repository,
    label: isEnglish ? "Source" : "Código",
    icon: "github" as const,
  },
].filter(Boolean) as Array<{ href: string; label: string; icon: "external" | "github" }>;
---

<Layout
  title={pageTitle}
  description={frontmatter.description}
  lang={currentLang}
  alternateUrl={frontmatter.alternateUrl}
  isProject
>
  <main id="main-content" class="case-page">
    <nav class="case-back no-print" aria-label={isEnglish ? "Project navigation" : "Navegación de proyecto"}>
      <a href={backHref}>{backLabel}</a>
    </nav>

    <article class="case-article">
      <header class="case-header">
        <h1>{frontmatter.title}</h1>
        {frontmatter.description && <p class="case-description">{frontmatter.description}</p>}

        {
          (metaItems.length > 0 || frontmatter.stack?.length || externalLinks.length > 0) && (
            <div class="case-meta" role="group" aria-label={isEnglish ? "Project details" : "Detalles del proyecto"}>
              {metaItems.length > 0 && (
                <p>
                  {metaItems.map((item, index) => (
                    <>
                      {index > 0 && <span aria-hidden="true"> · </span>}
                      <span>{item}</span>
                    </>
                  ))}
                </p>
              )}

              {frontmatter.stack && frontmatter.stack.length > 0 && (
                <ul class="case-stack" aria-label={isEnglish ? "Technologies" : "Tecnologías"}>
                  {frontmatter.stack.map((item) => <li>{item}</li>)}
                </ul>
              )}

              {externalLinks.length > 0 && (
                <nav class="case-links" aria-label={isEnglish ? "Project links" : "Links del proyecto"}>
                  {externalLinks.map((link) => (
                    <a href={link.href} target="_blank" rel="noopener noreferrer">
                      <ActionIcon name={link.icon} size={14} />
                      {link.label}
                    </a>
                  ))}
                </nav>
              )}
            </div>
          )
        }
      </header>

      <div class="case-content">
        <slot />
      </div>

      <footer class="case-footer no-print">
        <nav aria-label={isEnglish ? "Next steps" : "Siguientes pasos"}>
          <a href={isEnglish ? "/en/services/" : "/servicios/"}>{isEnglish ? "Services" : "Servicios"}</a>
          <a href={isEnglish ? "/en/#contact" : "/#contact"}>{isEnglish ? "Contact" : "Contacto"}</a>
          <a href={backHref}>{isEnglish ? "Back to projects" : "Volver a proyectos"}</a>
        </nav>
      </footer>
    </article>
  </main>

  <LanguageToggle />
  <ThemeToggle />
</Layout>

<style>
  .case-page {
    margin: auto;
    padding: 4rem;
    width: 100%;
  }

  .case-back,
  .case-article {
    margin-inline: auto;
    max-width: 700px;
  }

  .case-back {
    margin-bottom: 2.25rem;
  }

  .case-back a,
  .case-links a,
  .case-content :global(a) {
    color: var(--text-primary);
    font-weight: 600;
    text-decoration: none;
  }

  .case-back a:hover,
  .case-links a:hover,
  .case-content :global(a:hover) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .case-back a:focus-visible,
  .case-links a:focus-visible,
  .case-content :global(a:focus-visible) {
    border-radius: 4px;
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .case-article {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .case-header {
    border-bottom: 1px solid var(--border-light);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-bottom: 1.5rem;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.1;
  }

  .case-description {
    font-size: 1rem;
    line-height: 1.6;
  }

  .case-meta {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .case-meta p {
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  .case-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }

  .case-stack li {
    background: var(--bg-secondary);
    border-radius: 6px;
    color: var(--text-secondary);
    font-size: 0.7rem;
    font-weight: 500;
    line-height: 1.2;
    padding: 0.24rem 0.62rem;
  }

  .case-links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    font-size: 0.8rem;
  }

  .case-links a {
    align-items: center;
    display: inline-flex;
    flex-direction: row;
    gap: 5px;
    white-space: nowrap;
  }

  .case-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .case-content :global(h2),
  .case-content :global(h3) {
    line-height: 1.3;
    margin-top: 1rem;
  }

  .case-content :global(p),
  .case-content :global(li) {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .case-content :global(ul),
  .case-content :global(ol) {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    list-style: disc;
    margin: 0;
    padding-left: 1.25rem;
  }

  .case-content :global(ol) {
    list-style: decimal;
  }

  .case-content :global(code) {
    background: var(--bg-secondary);
    border-radius: 4px;
    color: var(--text-primary);
    font-size: 0.85em;
    padding: 0.1rem 0.3rem;
  }

  .case-content :global(.case-flow) {
    border-bottom: 1px solid var(--border-light);
    border-top: 1px solid var(--border-light);
    margin: 0.5rem 0 1rem;
    padding: 1rem 0;
    break-inside: avoid;
  }

  .case-content :global(.case-flow__steps) {
    align-items: center;
    display: flex;
    flex-direction: row;
    gap: 0.75rem;
    justify-content: space-between;
    list-style: none;
    padding: 0;
  }

  .case-content :global(.case-flow__steps li) {
    align-items: center;
    color: var(--text-secondary);
    display: flex;
    flex: 1 1 0;
    font-size: 0.8rem;
    font-weight: 600;
    gap: 0.75rem;
    justify-content: space-between;
    line-height: 1.35;
    min-width: 0;
  }

  .case-content :global(.case-flow__steps li > span:first-child) {
    overflow-wrap: anywhere;
  }

  .case-content :global(.case-flow__connector) {
    color: var(--text-muted);
    flex: 0 0 auto;
    font-weight: 500;
  }

  .case-content :global(.case-decisions) {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    margin-top: 0.25rem;
  }

  .case-content :global(.case-decision) {
    border-left: 1px solid var(--border);
    padding-left: 1rem;
    break-inside: avoid;
  }

  .case-content :global(.case-decision h3) {
    color: var(--text-primary);
    font-size: 0.95rem;
    line-height: 1.35;
    margin: 0 0 0.45rem;
  }

  .case-content :global(.case-decision p) {
    margin: 0;
  }

  .case-content :global(.case-decision p + p) {
    margin-top: 0.45rem;
  }

  .case-content :global(.case-decision strong) {
    color: var(--text-primary);
    font-weight: 700;
  }

  .case-content :global(figure),
  .case-content :global(.wide) {
    margin: 1.5rem 0 1.5rem 50%;
    max-width: none;
    transform: translateX(-50%);
    width: min(900px, calc(100vw - 2rem));
  }

  .case-content :global(.case-figure) {
    break-inside: avoid;
  }

  .case-content :global(.case-figure img) {
    border: 1px solid var(--border-light);
    border-radius: 8px;
    display: block;
    height: auto;
    width: 100%;
  }

  .case-content :global(.case-figure figcaption) {
    color: var(--text-muted);
    font-size: 0.75rem;
    line-height: 1.5;
    margin-top: 0.55rem;
  }

  .case-content :global(.case-figure__media) {
    border: 1px solid var(--border-light);
    border-radius: 8px;
    max-height: 820px;
    overflow: hidden;
  }

  .case-content :global(.case-figure__media img) {
    border: 0;
    border-radius: 0;
  }

  .case-footer {
    border-top: 1px solid var(--border-light);
    padding-top: 1.5rem;
  }

  .case-footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
  }

  .case-footer a {
    color: var(--text-primary);
    font-size: 0.8rem;
    font-weight: 650;
  }

  .case-footer a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .case-footer a:focus-visible {
    border-radius: 4px;
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  @media (width <= 700px) {
    .case-page {
      padding: 2rem;
    }

    .case-back {
      margin-bottom: 1.75rem;
    }

    .case-content :global(.case-flow__steps) {
      align-items: stretch;
      gap: 0.35rem;
    }

    .case-content :global(.case-flow__steps),
    .case-content :global(.case-flow__steps li) {
      flex-direction: column;
    }

    .case-content :global(.case-flow__steps li) {
      align-items: flex-start;
      gap: 0.35rem;
    }

    .case-content :global(.case-flow__connector) {
      padding-left: 0.2rem;
      transform: rotate(90deg);
      transform-origin: center;
    }

    .case-content :global(.case-figure__media) {
      max-height: 560px;
    }
  }

  @media (width <= 400px) {
    .case-page {
      padding-top: 5rem;
    }
  }

  @media print {
    .case-page {
      padding: 0;
    }

    .case-header {
      border-bottom-color: var(--border);
    }

    .case-content :global(.case-figure__media) {
      max-height: 720px;
    }
  }
</style>
