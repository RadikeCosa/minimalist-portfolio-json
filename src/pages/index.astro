---
import Layout from "@/layouts/Layout.astro";

import Differential from "@/components/sections/Differential.astro";
import Experience from "@/components/sections/Experience.astro";
import Hero from "@/components/sections/Hero.astro";
import Projects from "@/components/sections/Projects.astro";
import Skills from "@/components/sections/Skills.astro";
import Contact from "@/components/sections/Contact.astro";

import { getCV } from "@/i18n/utils";

const currentLang = "es";
const cvData = await getCV(currentLang);
const { name } = cvData.basics;
---

<Layout
  title={`${name} | Análisis y desarrollo de productos digitales`}
  description="Analizo necesidades, defino flujos y reglas de negocio, e implemento soluciones web. Experiencia en salud y especialización en HealthTech."
  lang={currentLang}
  alternateUrl="/en/"
  isHome
>
  <main id="main-content">
    <Hero lang={currentLang} />
    <Projects lang={currentLang} />
    <Differential lang={currentLang} />
    <Experience lang={currentLang} />
    <Skills lang={currentLang} />
    <Contact lang={currentLang} />
  </main>

</Layout>

<style>
  main {
    padding: 4rem;
    margin: auto;
    width: 100%;
  }

  @media (width <= 700px) {
    main {
      padding: 2rem 1.25rem;
    }
  }
</style>
